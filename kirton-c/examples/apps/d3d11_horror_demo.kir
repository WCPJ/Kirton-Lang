// Простой 3D-коридор (D3D11) с камерой от первого лица.
импорт "examples.lib.camera3d"

пусть ШИРИНА = 1280
пусть ВЫСОТА = 720
пусть ПИ = 3.1415926535

если d3d11.create_window(ШИРИНА, ВЫСОТА, "D3D11 horror corridor") == ложь {
    печатать("Не удалось создать окно D3D11")
    возврат
}

d3d11.enable_depth(истина)
d3d11.enable_cull(ложь)   // коридор двусторонний, чтобы исключить проблемы с порядком вершин
d3d11.enable_alpha(истина)
d3d11.viewport(ШИРИНА, ВЫСОТА)

// ----- Геометрия -----
пусть длина = 18.0
пусть ширина = 4.0
пусть высота = 3.0
пусть u_длина = длина * 0.3
пусть v_высота = 2.0

пусть пол_цвет = [0.6, 0.6, 0.65, 1.0]
пусть стена_цвет = [0.4, 0.45, 0.5, 1.0]
пусть потолок_цвет = [0.35, 0.35, 0.4, 1.0]

пусть half_w = ширина / 2
пусть half_h = высота / 2
пусть d = длина

пусть вершины = [
    // пол
    -half_w, -half_h, d, пол_цвет[0], пол_цвет[1], пол_цвет[2], пол_цвет[3], 0.0, 0.0,
     half_w, -half_h, d, пол_цвет[0], пол_цвет[1], пол_цвет[2], пол_цвет[3], u_длина, 0.0,
     half_w, -half_h, 0.0, пол_цвет[0], пол_цвет[1], пол_цвет[2], пол_цвет[3], u_длина, 2.0,
    -half_w, -half_h, 0.0, пол_цвет[0], пол_цвет[1], пол_цвет[2], пол_цвет[3], 0.0, 2.0,
    // потолок
    -half_w, half_h, 0.0,  потолок_цвет[0], потолок_цвет[1], потолок_цвет[2], потолок_цвет[3], 0.0, 0.0,
     half_w, half_h, 0.0,  потолок_цвет[0], потолок_цвет[1], потолок_цвет[2], потолок_цвет[3], u_длина, 0.0,
     half_w, half_h, d,   потолок_цвет[0], потолок_цвет[1], потолок_цвет[2], потолок_цвет[3], u_длина, 2.0,
    -half_w, half_h, d,   потолок_цвет[0], потолок_цвет[1], потолок_цвет[2], потолок_цвет[3], 0.0, 2.0,
    // левая стена
    -half_w, -half_h, d,  стена_цвет[0], стена_цвет[1], стена_цвет[2], стена_цвет[3], 0.0, 0.0,
    -half_w, -half_h, 0.0, стена_цвет[0], стена_цвет[1], стена_цвет[2], стена_цвет[3], u_длина, 0.0,
    -half_w, half_h, 0.0,  стена_цвет[0], стена_цвет[1], стена_цвет[2], стена_цвет[3], u_длина, v_высота,
    -half_w, half_h, d,    стена_цвет[0], стена_цвет[1], стена_цвет[2], стена_цвет[3], 0.0, v_высота,
    // правая стена
     half_w, -half_h, 0.0,  стена_цвет[0], стена_цвет[1], стена_цвет[2], стена_цвет[3], 0.0, 0.0,
     half_w, -half_h, d,    стена_цвет[0], стена_цвет[1], стена_цвет[2], стена_цвет[3], u_длина, 0.0,
     half_w, half_h, d,     стена_цвет[0], стена_цвет[1], стена_цвет[2], стена_цвет[3], u_длина, v_высота,
     half_w, half_h, 0.0,   стена_цвет[0], стена_цвет[1], стена_цвет[2], стена_цвет[3], 0.0, v_высота,
    // задняя стена
    -half_w, -half_h, d,    стена_цвет[0], стена_цвет[1], стена_цвет[2], стена_цвет[3], 0.0, 0.0,
    -half_w, half_h, d,     стена_цвет[0], стена_цвет[1], стена_цвет[2], стена_цвет[3], 0.0, v_высота,
     half_w, half_h, d,     стена_цвет[0], стена_цвет[1], стена_цвет[2], стена_цвет[3], ширина, v_высота,
     half_w, -half_h, d,    стена_цвет[0], стена_цвет[1], стена_цвет[2], стена_цвет[3], ширина, 0.0
]

пусть индексы = [
    0, 1, 2, 0, 2, 3,
    4, 5, 6, 4, 6, 7,
    8, 9, 10, 8, 10, 11,
    12, 13, 14, 12, 14, 15,
    16, 17, 18, 16, 18, 19
]

пусть следующий_индекс = 20
пусть число_индексов = 30

// Монстр (небольшой куб)
пусть монстр_цвет = [0.9, 0.15, 0.15, 1.0]
пусть mh = 0.8 / 2

пусть монстр_вершины = [
    // фронт -Z
    -mh, -mh, -mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 0.0, 0.0,
     mh, -mh, -mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 1.0, 0.0,
     mh,  mh, -mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 1.0, 1.0,
    -mh,  mh, -mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 0.0, 1.0,
    // задняя грань +Z
    -mh, -mh,  mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 0.0, 0.0,
    -mh,  mh,  mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 0.0, 1.0,
     mh,  mh,  mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 1.0, 1.0,
     mh, -mh,  mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 1.0, 0.0,
    // левая грань +X внутрь
    -mh, -mh,  mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 0.0, 0.0,
    -mh, -mh, -mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 1.0, 0.0,
    -mh,  mh, -mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 1.0, 1.0,
    -mh,  mh,  mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 0.0, 1.0,
    // правая грань -X внутрь
     mh, -mh, -mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 0.0, 0.0,
     mh, -mh,  mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 1.0, 0.0,
     mh,  mh,  mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 1.0, 1.0,
     mh,  mh, -mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 0.0, 1.0,
    // верх
    -mh,  mh, -mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 0.0, 0.0,
     mh,  mh, -mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 1.0, 0.0,
     mh,  mh,  mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 1.0, 1.0,
    -mh,  mh,  mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 0.0, 1.0,
    // низ
    -mh, -mh,  mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 0.0, 0.0,
     mh, -mh,  mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 1.0, 0.0,
     mh, -mh, -mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 1.0, 1.0,
    -mh, -mh, -mh, монстр_цвет[0], монстр_цвет[1], монстр_цвет[2], монстр_цвет[3], 0.0, 1.0
]

пусть монстр_индексы = [
    0,1,2, 0,2,3,
    4,5,6, 4,6,7,
    8,9,10, 8,10,11,
    12,13,14, 12,14,15,
    16,17,18, 16,18,19,
    20,21,22, 20,22,23
]

пусть монстр_индекс = 24
пусть монстр_число_индексов = 36

пусть vb = d3d11.create_vertex_buffer(вершины, 36, следующий_индекс)
пусть ib = d3d11.create_index_buffer(индексы, число_индексов)
пусть монстр_vb = d3d11.create_vertex_buffer(монстр_вершины, 36, монстр_индекс)
пусть монстр_ib = d3d11.create_index_buffer(монстр_индексы, монстр_число_индексов)

// Отладочный вывод размеров буферов
печатать("corridor verts:", следующий_индекс, "indices:", число_индексов, "floats:", следующий_индекс * 9)
печатать("monster verts:", монстр_индекс, "indices:", монстр_число_индексов, "floats:", монстр_индекс * 9)
печатать("vb handle:", vb, "ib handle:", ib, "monster_vb:", монстр_vb, "monster_ib:", монстр_ib)

если vb == 0 {
    печатать("vertex buffer corridor не создан")
    возврат
}
если ib == 0 {
    печатать("index buffer corridor не создан")
    возврат
}
если монстр_vb == 0 {
    печатать("vertex buffer монстра не создан")
    возврат
}
если монстр_ib == 0 {
    печатать("index buffer монстра не создан")
    возврат
}

пусть vs =
    "cbuffer cb0:register(b0){float4x4 u_mvp;};\n"
    + "struct VSIn{float3 pos:POSITION;float4 col:COLOR;float2 uv:TEXCOORD0;};\n"
    + "struct VSOut{float4 pos:SV_Position;float4 col:COLOR;float2 uv:TEXCOORD0;};\n"
    + "VSOut main(VSIn i){VSOut o;o.pos=mul(u_mvp,float4(i.pos,1.0));o.col=i.col;o.uv=i.uv;return o;}\n"

пусть ps =
    "Texture2D tex0:register(t0);SamplerState smp0:register(s0);\n"
    + "struct PSIn{float4 pos:SV_Position;float4 col:COLOR;float2 uv:TEXCOORD0;};\n"
    + "float4 main(PSIn i):SV_Target{float3 t=tex0.Sample(smp0,i.uv).rgb;float3 c=t*i.col.rgb;return float4(c,1.0);}\n"

пусть shader = d3d11.create_shader_pair(vs, ps)
если shader == 0 {
    печатать("Не удалось создать шейдеры")
    возврат
}

пусть tex = d3d11.load_texture("examples/assets/checker.png")
если tex == 0 {
    печатать("Не удалось загрузить текстуру checker.png")
    возврат
}
d3d11.bind_texture(tex)

пусть камера = camera3d.создать_камеру_от_первого_лица(math3d.vec3(0.0, 0.0, -2.0), 0.0, 0.0, 70.0 * ПИ / 180.0, ШИРИНА / ВЫСОТА, 0.1, 100.0)
пусть скорость = 0.08
пусть чувствительность = 0.0025
пусть мышь_пред = d3d11.mouse_pos()

пусть монстр_позиция = math3d.vec3(0.0, -0.4, 16.0)
пусть пойман = ложь
пусть кадры = 0

пусть старт_дист = math3d.vec3_distance(камера.позиция, монстр_позиция)
печатать("start distance:", старт_дист)

печатать("Инициализация завершена: шейдер", shader, "vb", vb, "ib", ib)

пока пойман == ложь и d3d11.poll() {
    кадры = кадры + 1
    если d3d11.key_down(27) { выход }   // ESC
    // ввод мыши
    пусть мышь = d3d11.mouse_pos()
    пусть dx = мышь[0] - мышь_пред[0]
    пусть dy = мышь[1] - мышь_пред[1]
    мышь_пред = мышь
    камера = camera3d.камера_повернуть(камера, dx * чувствительность, -dy * чувствительность)

    // ввод клавиатуры
    пусть вперёд = 0.0
    пусть вправо = 0.0
    пусть вверх = 0.0
    если d3d11.key_down(87) { вперёд = вперёд + скорость }       // W
    если d3d11.key_down(83) { вперёд = вперёд - скорость }       // S
    если d3d11.key_down(65) { вправо = вправо - скорость }       // A
    если d3d11.key_down(68) { вправо = вправо + скорость }       // D
    если d3d11.key_down(32) { вверх = вверх + скорость }         // SPACE
    если d3d11.key_down(17) { вверх = вверх - скорость }         // CTRL
    камера = camera3d.камера_переместить_local(камера, вперёд, вправо, вверх)

    // движение монстра к игроку
    пусть цель = math3d.vec3(камера.позиция[0], монстр_позиция[1], камера.позиция[2])
    пусть дельта = math3d.vec3_sub(цель, монстр_позиция)
    пусть шаг = 0.02
    пусть направление = math3d.vec3_normalize(дельта)
    монстр_позиция = math3d.vec3_add(монстр_позиция, math3d.vec3_scale(направление, шаг))

    // проверка столкновения
    пусть дистанция = math3d.vec3_distance(камера.позиция, монстр_позиция)
    если дистанция < 1.0 {
        печатать("Монстр поймал вас!")
        пойман = истина
    }

    d3d11.clear(0.02, 0.03, 0.05, 1.0)

    пусть view_proj = camera3d.камера_матрица_vp(камера)
    d3d11.set_mvp(view_proj)
    d3d11.draw_indexed(vb, ib, shader, 0)

    пусть world_mon = math3d.mat4_translation(монстр_позиция[0], монстр_позиция[1], монстр_позиция[2])
    пусть mvp_mon = math3d.mat4_mul(view_proj, world_mon)
    d3d11.set_mvp(mvp_mon)
    d3d11.draw_indexed(монстр_vb, монстр_ib, shader, 0)

    d3d11.present(1)
}

если пойман == ложь {
    печатать("Вы закрыли окно. Кадров отрисовано:", кадры)
}

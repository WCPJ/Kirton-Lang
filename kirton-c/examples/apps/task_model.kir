перечисление СостояниеЗадачи {
    открыта
    завершена
}

структура Задача {
    название: строка
    состояние: СостояниеЗадачи
}

функция создать(название) {
    вернуть Задача(название: название, состояние: СостояниеЗадачи.открыта)
}

функция завершить(задача) {
    задача.состояние = СостояниеЗадачи.завершена
    вернуть задача
}

функция завершена_ли(задача) {
    вернуть задача.состояние == СостояниеЗадачи.завершена
}

функция открытых(задачи) {
    пусть количество = 0
    для каждого задача в задачи {
        если задача.состояние == СостояниеЗадачи.открыта {
            количество = количество + 1
        }
    }
    вернуть количество
}

// examples/apps/kirtos_init.kir
// Логический "init" KirtonOS в режиме гостя (host).
// Запускается поверх обычной ОС, но организован как ядро будущей KirtonOS.

пусть версия_ос = "KirtonOS 0.0.1 (host прототип)"

функция init_сообщить(tag, сообщение) {
    печатать("[", tag, "] ", сообщение)
}

функция показать_баннер() {
    печатать("=======================================")
    печатать("   ", версия_ос)
    печатать("   Ядро: интерпретатор Киртона")
    печатать("=======================================")
}

функция показать_окружение() {
    init_сообщить("init", "сбор служебного окружения")
    пусть env = окружение()
    пусть важные = ["OS", "USERNAME", "USERPROFILE", "HOME", "KIRTON_PATH"]

    для каждого имя в важные {
        пусть значение = env[имя]
        печатать("  ", имя, " = ", значение)
    }
}

функция показать_файлы() {
    init_сообщить("init", "просмотр текущей папки")
    пусть cwd = текущая_папка()
    печатать("  текущая_папка(): ", cwd)

    пусть файлы = фс_список(".")
    для каждого имя в файлы {
        печатать("  - ", имя)
    }
}

функция запустить_оболочку() {
    init_сообщить("init", "загрузка оболочки (kirtos_shell.kir)")
    // Ожидается, что файл kirtos_shell.kir лежит в той же папке.
    импорт "kirtos_shell" из "examples/apps"
    kirtos_shell.оболочка_начать()
}

функция начать() {
    показать_баннер()
    показать_окружение()
    показать_файлы()
    печатать("")
    init_сообщить("init", "передача управления оболочке")
    запустить_оболочку()
    init_сообщить("init", "возврат из оболочки — завершение init")
}

начать()

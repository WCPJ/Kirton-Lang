импорт "expense_model" как модель из "."

пусть расходы = [
    модель.создать("Обед", 12.50, модель.еда()),
    модель.создать("Автобус", 3.25, модель.транспорт()),
    модель.создать("Продукты", 18.75, модель.еда())
]

пусть еда = модель.посчитать(расходы, модель.еда())
пусть транспорт = модель.посчитать(расходы, модель.транспорт())
если еда == 31.25 и транспорт == 3.25 {
    печатать("Еда:", еда)
    печатать("Транспорт:", транспорт)
    печатать("EXPENSE_REPORT_OK")
} иначе {
    печатать("EXPENSE_REPORT_FAIL", еда, транспорт)
}

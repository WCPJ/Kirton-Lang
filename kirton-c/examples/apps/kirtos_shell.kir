# kirtos_shell.kir — простейшая заглушка оболочки KirtonOS.
# Никакой магии, только текст, чтобы убедиться, что всё работает.

функция оболочка_начать() {
    печатать("")
    печатать("=== KirtonShell v0.0.1 ===")
    печатать("Добро пожаловать в прототип оболочки KirtonOS.")
    печатать("Пока здесь только текст, без командной строки.")
    печатать("Дальше мы добавим ввод команд, ls, cat, run и т.д.")
    печатать("")
}

пусть ШИРИНА = 800
пусть ВЫСОТА = 600

пусть ПАЛКА_ШИРИНА = 15
пусть ПАЛКА_ВЫСОТА = 100
пусть ОТСТУП_ПАЛКИ = 40
пусть РАДИУС_ШАРА = 10

функция начать() {
    окно(ШИРИНА, ВЫСОТА, "Киртон: Понг")
    FPS_цель(0)

    пусть мяч_x = ШИРИНА / 2
    пусть мяч_y = ВЫСОТА / 2
    пусть мяч_vx = 5
    пусть мяч_vy = 3

    пусть левая_y = (ВЫСОТА - ПАЛКА_ВЫСОТА) / 2
    пусть правая_y = (ВЫСОТА - ПАЛКА_ВЫСОТА) / 2

    пусть левая_скорость = 5
    пусть правая_скорость = 5

    пусть счёт_левый = 0
    пусть счёт_правый = 0

    пусть старт = таймер_старт()
    пусть кадры = 0
    пусть фпс = 0

    пока окно_открыто() {
        очистить(10, 10, 20)

        кадры = кадры + 1
        пусть прошло = таймер_прошло(старт)
        если прошло >= 1000 {
            фпс = кадры
            кадры = 0
            старт = таймер_старт()
            печатать("FPS: ", фпс, " | Счёт: ", счёт_левый, " : ", счёт_правый)
        }

        если клавиша_зажата(87) {
            левая_y = левая_y - левая_скорость
        }

        если клавиша_зажата(83) {
            левая_y = левая_y + левая_скорость
        }

        если клавиша_зажата(38) {
            правая_y = правая_y - правая_скорость
        }

        если клавиша_зажата(40) {
            правая_y = правая_y + правая_скорость
        }

        если левая_y < 0 {
            левая_y = 0
        }

        если левая_y + ПАЛКА_ВЫСОТА > ВЫСОТА {
            левая_y = ВЫСОТА - ПАЛКА_ВЫСОТА
        }

        если правая_y < 0 {
            правая_y = 0
        }

        если правая_y + ПАЛКА_ВЫСОТА > ВЫСОТА {
            правая_y = ВЫСОТА - ПАЛКА_ВЫСОТА
        }

        мяч_x = мяч_x + мяч_vx
        мяч_y = мяч_y + мяч_vy

        если мяч_y - РАДИУС_ШАРА < 0 {
            мяч_y = РАДИУС_ШАРА
            мяч_vy = -мяч_vy
        }

        если мяч_y + РАДИУС_ШАРА > ВЫСОТА {
            мяч_y = ВЫСОТА - РАДИУС_ШАРА
            мяч_vy = -мяч_vy
        }

        пусть левая_x = ОТСТУП_ПАЛКИ
        пусть правая_x = ШИРИНА - ОТСТУП_ПАЛКИ - ПАЛКА_ШИРИНА

        если мяч_vx < 0 {
            если мяч_x - РАДИУС_ШАРА <= левая_x + ПАЛКА_ШИРИНА {
                если мяч_y >= левая_y {
                    если мяч_y <= левая_y + ПАЛКА_ВЫСОТА {
                        мяч_x = левая_x + ПАЛКА_ШИРИНА + РАДИУС_ШАРА
                        мяч_vx = -мяч_vx
                    }
                }
            }
        }

        если мяч_vx > 0 {
            если мяч_x + РАДИУС_ШАРА >= правая_x {
                если мяч_y >= правая_y {
                    если мяч_y <= правая_y + ПАЛКА_ВЫСОТА {
                        мяч_x = правая_x - РАДИУС_ШАРА
                        мяч_vx = -мяч_vx
                    }
                }
            }
        }

        если мяч_x < 0 {
            счёт_правый = счёт_правый + 1
            мяч_x = ШИРИНА / 2
            мяч_y = ВЫСОТА / 2
            мяч_vx = 5
            мяч_vy = 3
        }

        если мяч_x > ШИРИНА {
            счёт_левый = счёт_левый + 1
            мяч_x = ШИРИНА / 2
            мяч_y = ВЫСОТА / 2
            мяч_vx = -5
            мяч_vy = 3
        }

        прямоугольник(левая_x, левая_y, ПАЛКА_ШИРИНА, ПАЛКА_ВЫСОТА, 0x00FFAA, 1)
        прямоугольник(правая_x, правая_y, ПАЛКА_ШИРИНА, ПАЛКА_ВЫСОТА, 0xFFAA00, 1)

        пусть линия_x = ШИРИНА / 2
        пусть yy = 0
        пока yy < ВЫСОТА {
            прямоугольник(линия_x - 1, yy, 2, 10, 0x444444, 1)
            yy = yy + 20
        }

        окружность(мяч_x, мяч_y, РАДИУС_ШАРА, 255, 255, 255)

        текст(10, 10, "W/S слева, стрелки сверху/снизу справа, ESC - выход", 18, 0xFFFFFF)

        если клавиша_зажата(27) {
            возврат 0
        }

        живо_шаг()
    }

    возврат 0
}
начать()

функция начать() {
    окно(1920, 1080, "Smoke test: звук и BMP (full-size)")
    FPS_цель(60)

    пусть звук_id = звук_загрузить("data/test.wav")
    пусть картинка_id = картинка_загрузить("data/test.bmp")

    печатать("звук_загрузить -> ", звук_id)
    печатать("картинка_загрузить -> ", картинка_id)

    если звук_id > 0 {
        звук_играть(звук_id)
    }

    пусть bmp_w = 0
    пусть bmp_h = 0
    если картинка_id > 0 {
        пусть размер = картинка_размер(картинка_id)
        bmp_w = размер[0]
        bmp_h = размер[1]
        печатать("BMP размер: ", bmp_w, " x ", bmp_h)
    }

    пусть экран_x = 1300      # позиция вывода BMP
    пусть экран_y = 200

    пока окно_открыто() {
        если клавиша_зажата(27) {
            возврат
        }

        очистить(32, 32, 32)

        текст(10, 10, "Тест: звук + BMP", 22, 0xFFFFFF)
        текст(10, 40, "ESC - выход", 18, 0xAAAAAA)

        если звук_id == 0 {
            текст(10, 70, "ЗВУК: ошибка загрузки data/test.wav", 16, 0xFF5555)
        } иначе {
            текст(10, 70, "ЗВУК: ок, id =", 16, 0x55FF55)
        }

        если картинка_id == 0 {
            текст(10, 95, "BMP: ошибка загрузки data/test.bmp", 16, 0xFF5555)
        } иначе {
            текст(10, 95, "BMP: вывод 512×512 (натуральный размер)", 16, 0x55FF55)

            пусть yy = 0
            пока yy < bmp_h {
                пусть xx = 0
                пока xx < bmp_w {
                    пусть цвет = картинка_пиксель(картинка_id, xx, yy)
                    если цвет >= 0 {
                        прямоугольник(экран_x + xx, экран_y + yy, 1, 1, цвет, 1)
                    }
                    xx = xx + 1
                }
                yy = yy + 1
            }
        }

        живо_шаг()
    }
}

начать()

импорт "task_model" как модель из "."

пусть задачи = [
    модель.создать("Проверить память"),
    модель.создать("Сверить модули"),
    модель.создать("Подготовить релиз")
]

модель.завершить(задачи[0])

попробовать {
    модель.завершить("не задача")
} перехватить ошибка {
    печатать("Ошибка обработана:", ошибка.код)
} всегда {
    печатать("Обработка завершена")
}

печатать("Открытых задач:", модель.открытых(задачи))
для каждого задача в задачи {
    если модель.завершена_ли(задача) {
        печатать("✓", задача.название)
    } иначе {
        печатать("·", задача.название)
    }
}
печатать("TASK_TRACKER_OK")

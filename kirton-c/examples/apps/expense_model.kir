перечисление Категория {
    еда
    транспорт
    другое
}

структура Расход {
    описание: строка
    сумма: число
    категория: Категория
}

функция еда() {
    вернуть Категория.еда
}

функция транспорт() {
    вернуть Категория.транспорт
}

функция создать(описание, сумма, категория) {
    вернуть Расход(описание: описание, сумма: сумма, категория: категория)
}

функция посчитать(расходы, категория) {
    пусть сумма = 0.0
    для каждого расход в расходы {
        если расход.категория == категория {
            сумма = сумма + расход.сумма
        }
    }
    вернуть сумма
}

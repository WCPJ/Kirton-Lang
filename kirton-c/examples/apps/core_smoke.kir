пусть были_ошибки = ложь

функция отметить_ошибку() {
    были_ошибки = истина
}

функция утверждать(условие, сообщение) {
    если не условие {
        отметить_ошибку()
        печатать("FAIL:", сообщение)
    }
}

функция утверждать_равно(факт, ожидаемое, сообщение) {
    если факт == ожидаемое {
        возврат
    }
    отметить_ошибку()
    печатать("FAIL:", сообщение, "ожидалось", ожидаемое, "получено", факт)
}

функция тест_арифметика() {
    печатать("[тест_арифметика]")
    пусть a = 1 + 2 * 3
    утверждать_равно(a, 7, "1 + 2 * 3")

    пусть b = (1 + 2) * 3
    утверждать_равно(b, 9, "(1 + 2) * 3")

    пусть mixed = 1 + 2 * 3 + 4
    утверждать_равно(mixed, 11, "1 + 2 * 3 + 4")

    пусть mixed2 = 1 + 2 * 3 + 4 * 5
    утверждать_равно(mixed2, 27, "1 + 2 * 3 + 4 * 5")

    пусть c = 0xFF
    утверждать_равно(c, 255, "hex 0xFF")

    пусть d = 0x10 + 5
    утверждать_равно(d, 21, "hex 0x10 + 5")

    пусть e = 10 / 2
    утверждать_равно(e, 5, "10 / 2")

    пусть f = 5 > 3
    утверждать(f, "5 > 3")

    пусть g = 3 >= 3
    утверждать(g, "3 >= 3")

    пусть h = 2 < 1
    утверждать(не h, "2 < 1 должно быть ложь")
}

функция тест_числовая_модель() {
    печатать("[тест_числовая_модель]")
    пусть выше_точности_double = 9007199254740993
    утверждать_равно(выше_точности_double + 1, 9007199254740994, "целое точнее double")
    утверждать_равно(выше_точности_double == 9007199254740992.0, ложь, "большое целое точно сравнивается с float")
    утверждать_равно(0x20000000000001, выше_точности_double, "шестнадцатеричное целое сохраняет точность")
    утверждать_равно(число_из_строки("0x20000000000001"), выше_точности_double, "разбор строки сохраняет большое hex-целое")

    пусть выше_int64 = 9223372036854775808
    утверждать_равно(выше_int64 + 1, 9223372036854775809, "целое расширяется за int64")
    утверждать_равно(выше_int64 * 2, 18446744073709551616, "умножение больших целых точное")
    утверждать_равно(выше_int64 - 1, 9223372036854775807, "вычитание возвращается к int64 без потери точности")
    пусть ниже_int64 = -9223372036854775809
    утверждать_равно(ниже_int64, -9223372036854775809, "отрицательное большое целое сохраняет знак и точность")
    утверждать_равно(ниже_int64 < -9223372036854775808.0, истина, "отрицательное целое точно сравнивается с float")
    утверждать_равно(сумма([выше_int64, 1]), 9223372036854775809, "сумма списка сохраняет точность")
    утверждать_равно(число_из_строки("9223372036854775808"), выше_int64, "парсер чисел сохраняет большие целые")
    утверждать_равно(тип(выше_int64), "целое", "тип целого числа")
    утверждать_равно(тип(1.0), "число", "тип вещественного числа")
    утверждать_равно(тип(5 / 2), "число", "деление возвращает вещественное число")
    утверждать_равно(тип(строка_длина("Киртон")), "целое", "длина строки возвращает целое")
    утверждать_равно(тип(список_длина([1, 2])), "целое", "длина списка возвращает целое")
    утверждать_равно(1 == 1.0, истина, "равные целое и float сравнимы")
    утверждать_равно(выше_int64 == 9223372036854775808.0, истина, "точное целое сравнивается с вещественным")

    пусть json = json_написать(выше_int64)
    утверждать_равно(json, "9223372036854775808", "JSON сериализует большое целое точно")
    утверждать_равно(json_прочитать(json), выше_int64, "JSON round-trip сохраняет большое целое")
    пусть json_float = json_написать(1.0)
    утверждать_равно(json_float, "1.0", "JSON сохраняет вещественный тип числа")
    утверждать_равно(тип(json_прочитать(json_float)), "число", "JSON round-trip сохраняет вещественное число")
}

функция пустое_значение() {
}

функция пустой_возврат() {
    вернуть
}

функция тест_равенство() {
    печатать("[тест_равенство]")
    утверждать_равно(пусто == пусто, истина, "пусто равно пусто")
    утверждать_равно(тип(пусто), "пусто", "тип пустого значения")
    утверждать_равно(пустое_значение() == пустое_значение(), истина, "nil равен nil")
    утверждать_равно(пустой_возврат(), пусто, "пустой вернуть возвращает пусто")
    утверждать_равно(строка_длина("А\nБ"), 3, "\\n превращается в перевод строки")
    утверждать_равно("a\"b" == "a\"b", истина, "экранированная кавычка")
    утверждать_равно(строка_длина("A\\B"), 3, "экранированная обратная косая черта")
    утверждать_равно([1, {"x": [2, 3]}], [1, {"x": [2, 3]}], "вложенные коллекции равны по содержимому")
    утверждать_равно({"a": 1, "b": 2}, {"b": 2, "a": 1}, "порядок ключей словаря не влияет на равенство")
    утверждать_равно({"a": 1} == {"a": 2}, ложь, "словари с разными значениями не равны")
}

функция тест_списки_словари() {
    печатать("[тест_списки_словари]")

    пусть L = [1, 2, 3]
    утверждать_равно(L[0], 1, "L[0] == 1")
    утверждать_равно(L[2], 3, "L[2] == 3")

    L[1] = 10
    утверждать_равно(L[1], 10, "присваивание L[1] = 10")

    пусть D = { "x": 1, y: 2 }
    утверждать_равно(D.x, 1, "D.x == 1")
    утверждать_равно(D.y, 2, "D.y == 2")

    D.y = 5
    утверждать_равно(D.y, 5, "D.y после присваивания")

    D.z = 100
    утверждать_равно(D.z, 100, "D.z == 100")

    пусть L2 = [0]
    для каждого v в [1, 2, 3] {
        L2[0] = v     // проверяем присваивание по индексу, но без выхода за границы
    }
    утверждать_равно(L2[0], 3, "последнее значение в L2 после цикла")
}

// --- вместо настоящих замыканий: глобальный счётчик ---
пусть счётчик_значение = 0

функция счётчик_сброс() {
    счётчик_значение = 0
}

функция счётчик_добавить(насколько) {
    счётчик_значение = счётчик_значение + насколько
    вернуть счётчик_значение
}

функция тест_замыкания() {
    печатать("[тест_замыкания]")
    счётчик_сброс()
    утверждать_равно(счётчик_добавить(1), 1, "closure шаг 1 (через глобальный счётчик)")
    утверждать_равно(счётчик_добавить(2), 3, "closure шаг 2 (через глобальный счётчик)")
    утверждать_равно(счётчик_добавить(5), 8, "closure шаг 3 (через глобальный счётчик)")
}

функция тест_fs_os() {
    печатать("[тест_fs_os]")

    пусть файл = "tmp_kirton_test.txt"
    пусть текст = "привет мир"

    пусть ок = фс_записать_текст(файл, текст)
    утверждать(ок, "фс_записать_текст")

    утверждать(фс_есть(файл), "фс_есть после записи")

    пусть проч = фс_прочитать_текст(файл)
    утверждать_равно(проч, текст, "фс_прочитать_текст совпадает с записанным")

    // список директории: просто проверяем, что что-то есть
    пусть список = фс_список(".")
    пусть есть = ложь
    для каждого имя в список {
        есть = истина
    }
    утверждать(есть, "фс_список('.') не пустой")

    // env: сначала ставим переменную, потом читаем всё окружение словарём
    пусть ок2 = установить_окружение("KIRTON_TEST_ENV", "123")
    утверждать(ок2, "установить_окружение")

    пусть env = окружение()
    утверждать_равно(env["KIRTON_TEST_ENV"], "123", "окружение KIRTON_TEST_ENV")

    // cwd
    пусть cwd = текущая_папка()
    утверждать(str_len(cwd) > 0, "текущая_папка не пустая")

    // удаление файла
    пусть ок3 = удалить_файл(файл)
    утверждать(ок3, "удалить_файл")
    утверждать(не фс_есть(файл), "файл после удаления отсутствует")
}

функция тест_import_include() {
    печатать("[тест_import_include]")

    // создаём файл модуля для проверки импорта
    пусть мод_код = "функция мод_значение() { вернуть 42 }"
    пусть мод_имя = "tmp_mod"
    пусть мод_файл = "tmp_mod.кир"
    фс_записать_текст(мод_файл, мод_код)

    // Импорт открывает пространство имён модуля.
    импорт "tmp_mod" из "."
    пусть v = tmp_mod.мод_значение()
    утверждать_равно(v, 42, "квалифицированный вызов функции модуля")

    // Повторный псевдоним должен указывать на последний импортированный модуль.
    фс_записать_текст("tmp_mod_a.кир", "функция значение() { вернуть 1 }")
    фс_записать_текст("tmp_mod_b.кир", "функция значение() { вернуть 2 }")
    импорт "tmp_mod_a" как общий из "."
    импорт "tmp_mod_b" как общий из "."
    утверждать_равно(общий.значение(), 2, "повторный псевдоним указывает на новый модуль")

    // include
    пусть inc_код = "пусть x_из_включения = 99"
    пусть inc_файл = "tmp_inc.кир"
    фс_записать_текст(inc_файл, inc_код)

    включить "tmp_inc.кир"
    утверждать_равно(x_из_включения, 99, "переменная из включённого файла")

    // подчистим, если сможем
    удалить_файл(мод_файл)
    удалить_файл(inc_файл)
    удалить_файл("tmp_mod_a.кир")
    удалить_файл("tmp_mod_b.кир")
}

функция запустить_тесты() {
    печатать("=== Тесты ядра Киртона ===")

    тест_арифметика()
    тест_числовая_модель()
    тест_равенство()
    тест_списки_словари()
    тест_замыкания()
    тест_fs_os()
    тест_import_include()

    если были_ошибки {
        печатать("ИТОГ: ЕСТЬ ОШИБКИ — смотри FAIL выше")
    } иначе {
        печатать("ИТОГ: ВСЁ ОК, ядро выглядит живым")
    }
}

функция начать() {
    запустить_тесты()
}

начать()

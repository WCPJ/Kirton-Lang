пусть имя = "Аня"
пусть счет = 3
печатать("Привет, " + имя)
счет = счет + 1

если счет > 3 {
    печатать("тепло")
} иначе {
    печатать("прохладно")
}

пусть i = 0
пока i < 3 {
    i = i + 1
}

функция удвоить(число) {
    вернуть число * 2
}

пусть числа = [2, 4, 6]
пусть карточка = {"имя": "Киртон", "версия": 1}
если удвоить(числа[0]) == 4 и карточка["имя"] == "Киртон" {
    печатать("GETTING_STARTED_OK")
}

пусть нечисло = нан()
пусть бесконечность = беск()
пусть минус_бесконечность = -беск()

пусть nan_проверки =
    нечисло != нечисло и
    не (нечисло == нечисло) и
    не (нечисло < 0) и
    не (нечисло <= 0) и
    не (нечисло > 0) и
    не (нечисло >= 0) и
    не (0 < нечисло) и
    не (0 <= нечисло) и
    не (0 > нечисло) и
    не (0 >= нечисло)

пусть inf_проверки =
    бесконечность == бесконечность и
    минус_бесконечность == минус_бесконечность и
    бесконечность > 100000000000000000000 и
    минус_бесконечность < -100000000000000000000 и
    бесконечность > минус_бесконечность и
    минус_бесконечность < бесконечность

пусть ноль_проверки =
    -0.0 == 0.0 и
    не (-0.0 < 0.0) и
    не (-0.0 > 0.0) и
    не (0.0 < -0.0) и
    не (0.0 > -0.0)

если nan_проверки и inf_проверки и ноль_проверки то
    печатать("NUMERIC_SPECIAL_OK")
иначе
    печатать("NUMERIC_SPECIAL_FAIL")
конец

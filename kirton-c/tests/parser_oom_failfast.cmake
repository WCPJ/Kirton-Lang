set(fail_fast_count 0)
set(success_count 0)
foreach(fail_after RANGE 0 63)
  set(oom_command "${PARSER_OOM_TEST}" "${fail_after}")
  if(DEFINED ENV{KIRTON_OOM_DISABLE_LSAN})
    set(oom_command "${CMAKE_COMMAND}" -E env "ASAN_OPTIONS=detect_leaks=0" ${oom_command})
  endif()
  execute_process(COMMAND ${oom_command}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error_output
    TIMEOUT 5)
  if(result EQUAL 0)
    math(EXPR success_count "${success_count} + 1")
  elseif(error_output MATCHES "OOM \\((malloc|realloc|calloc)")
    if(error_output MATCHES "AddressSanitizer|LeakSanitizer|UndefinedBehaviorSanitizer|runtime error:")
      message(FATAL_ERROR "Parser OOM child emitted sanitizer diagnostics at failure index ${fail_after}: ${error_output}")
    endif()
    math(EXPR fail_fast_count "${fail_fast_count} + 1")
  else()
    message(FATAL_ERROR "Failure index ${fail_after} did not exit through the allocator diagnostic: ${output}${error_output}")
  endif()
endforeach()
if(fail_fast_count EQUAL 0 OR success_count EQUAL 0)
  message(FATAL_ERROR "Expected injected parser failures and later successful parses; fail-fast=${fail_fast_count}, success=${success_count}")
endif()
message(STATUS "Parser allocation injection: ${fail_fast_count} fail-fast exits, ${success_count} successful parses")

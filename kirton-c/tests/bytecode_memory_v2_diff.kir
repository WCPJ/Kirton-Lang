импорт память

функция main()
    пусть область = память.создать(256)
    пусть буфер = память.выделить(область, 16, 8)
    память.записать(буфер, 3, 217)
    печатать(память.прочитать(буфер, 3))

    пусть массив = память.массив(область, "целое64", 4)
    память.положить(массив, 2, 9007199254740993)
    печатать(память.взять(массив, 2))

    пусть схема = память.структура("номер", "целое64", "вес", "число64")
    пусть запись = память.запись(область, схема)
    память.положить_поле(запись, "номер", 9007199254740995)
    память.положить_поле(запись, "вес", 1.5)

    пусть счетчик = 0
    пока счетчик < 1200
        пусть временный = [счетчик, {"значение": счетчик}]
        счетчик = счетчик + 1
    конец

    печатать(память.прочитать(буфер, 3), память.взять(массив, 2))
    печатать(память.взять_поле(запись, "номер"), память.взять_поле(запись, "вес"))

    память.закрыть(область)
конец

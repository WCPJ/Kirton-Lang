пусть большой = 100000000000000000000
печатать(большой << 2)
печатать(большой >> 2)
печатать(-2 >> 1)
печатать(-2 << 3)
печатать(-1 << 64)
печатать(-18446744073709551616 >> 64)
печатать(~0)
печатать(~(-1))
печатать(12 & 10)
печатать(12 | 10)
печатать(12 ^ 10)
печатать(-5 & 3)
печатать(-5 | 3)
печатать(-5 ^ 3)
печатать(1 | 2 & 4)
печатать(1 << 2 + 1)
функция вычислить(вход) {
    вернуть (вход << 3) ^ 255
}
печатать(вычислить(9223372036854775808))

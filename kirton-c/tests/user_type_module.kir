структура Данные
    значение: целое
конец

перечисление Состояние
    ожидание
    активно
конец

функция создать()
    вернуть Данные(значение: 10)
конец

функция состояние()
    вернуть Состояние.активно
конец

функция активно_ли(состояние)
    вернуть состояние == Состояние.активно
конец

функция создать_счётчик()
    пусть данные = Данные(значение: 30)
    функция следующий()
        данные.значение = данные.значение + 1
        вернуть данные
    конец
    вернуть следующий
конец

функция испортить(данные)
    данные.значение = "ошибка"
    вернуть данные
конец

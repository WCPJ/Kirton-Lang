импорт память

пусть схема = память.структура("метка", "байт", "номер", "целое64", "счёт", "целое32", "скорость", "число64")
пусть ok = тип(схема) == "структура_памяти"
ok = ok и память.размер_структуры(схема) == 32
ok = ok и память.выравнивание_структуры(схема) == 8
ok = ok и память.смещение_поля(схема, "метка") == 0
ok = ok и память.смещение_поля(схема, "номер") == 8
ok = ok и память.смещение_поля(схема, "счёт") == 16
ok = ok и память.смещение_поля(схема, "скорость") == 24
ok = ok и память.тип_поля(схема, "номер") == "целое64"
пусть область = память.создать(96)
пусть игрок = память.запись(область, схема)
ok = ok и тип(игрок) == "запись_памяти"
ok = ok и игрок.номер == 0 и игрок["скорость"] == 0
игрок.метка = 255
игрок["номер"] = 9007199254740993
игрок.счёт = -2147483648
память.положить_поле(игрок, "скорость", 1.25)
ok = ok и память.взять_поле(игрок, "метка") == 255
ok = ok и игрок.номер == 9007199254740993 и игрок["счёт"] == -2147483648
ok = ok и игрок.скорость == 1.25
пусть ссылка = игрок
ссылка.счёт = 19
ok = ok и игрок.счёт == 19
пусть второй = память.запись(область, схема)
ok = ok и второй.номер == 0
второй.номер = 42
ok = ok и игрок.номер == 9007199254740993 и второй.номер == 42
память.сбросить(область)
ok = ok и не память.действительна_запись(игрок)
пусть третий = память.запись(область, схема)
ok = ok и третий.номер == 0
память.закрыть(область)
ok = ok и не память.действительна_запись(третий)
если ok то
    печатать("MEMORY_V2_RECORD_OK")
иначе
    печатать("MEMORY_V2_RECORD_FAIL")
конец

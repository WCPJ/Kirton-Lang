if(NOT DEFINED KIRTON OR NOT DEFINED SOURCE)
  message(FATAL_ERROR "KIRTON and SOURCE required")
endif()
foreach(mode IN ITEMS ast bytecode)
  if(mode STREQUAL "bytecode")
    execute_process(COMMAND "${KIRTON}" --bytecode "${SOURCE}"
      RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic TIMEOUT 20)
  else()
    execute_process(COMMAND "${KIRTON}" "${SOURCE}"
      RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic TIMEOUT 20)
  endif()
  if(NOT "${status}" STREQUAL "1" OR NOT "${output}" STREQUAL "" OR "${diagnostic}" STREQUAL "")
    message(FATAL_ERROR "${mode} error contract failed: code=${status}, out=${output}, err=${diagnostic}")
  endif()
endforeach()
if(CMAKE_HOST_WIN32)
  set(suffix ".exe")
else()
  set(suffix "")
endif()
get_filename_component(name "${SOURCE}" NAME_WE)
set(exe "${CMAKE_CURRENT_BINARY_DIR}/${name}${suffix}")
execute_process(COMMAND "${KIRTON}" --native "${SOURCE}" -o "${exe}"
  RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error TIMEOUT 20)
if(NOT "${code}" STREQUAL "0" OR NOT "${out}" STREQUAL "" OR NOT "${error}" STREQUAL "")
  message(FATAL_ERROR "Native compile failed: ${code} ${out} ${error}")
endif()
execute_process(COMMAND "${exe}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE error TIMEOUT 20)
if(NOT "${code}" STREQUAL "1" OR NOT "${out}" STREQUAL "" OR "${error}" STREQUAL "")
  message(FATAL_ERROR "Native error contract failed: ${code} ${out} ${error}")
endif()

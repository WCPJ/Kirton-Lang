пусть большой = 100000000000000000000
пусть числа_верны = (
    7 нацело 3 == 2 и
    -7 нацело 3 == -3 и
    7 нацело -3 == -3 и
    -7 нацело -3 == 2 и
    -7 % 3 == 2 и
    7 % -3 == -2 и
    -7 % -3 == -1 и
    -9223372036854775808 нацело -1 == 9223372036854775808 и
    -9223372036854775808 % -1 == 0 и
    7.5 нацело 2.0 == 3.0 и
    -7.5 % 3.0 == 1.5 и
    7.5 % -3.0 == -1.5 и
    большой нацело 3 == 33333333333333333333 и
    большой % 3 == 1 и
    -большой нацело 3 == -33333333333333333334 и
    -большой % 3 == 2 и
    большой нацело -3 == -33333333333333333334 и
    большой % -3 == -2 и
    большой << 2 == 400000000000000000000 и
    большой >> 2 == 25000000000000000000 и
    большой & 255 == большой % 256 и
    (-большой) & 255 == (-большой) % 256 и
    ~большой == -большой - 1 и
    ~0 == -1 и
    ~(-1) == 0 и
    -2 >> 1 == -1 и
    -2 << 3 == -16 и
    -1 << 64 == -18446744073709551616 и
    -18446744073709551616 >> 64 == -1 и
    12 & 10 == 8 и
    12 | 10 == 14 и
    12 ^ 10 == 6 и
    -5 & 3 == 3 и
    -5 | 3 == -5 и
    -5 ^ 3 == -8 и
    1 | 2 & 4 == 1 и
    1 << 2 + 1 == 8
)

если числа_верны то
    печатать("NUMERIC_OPS_OK")
иначе
    печатать("NUMERIC_OPS_FAIL")
    печатать("div/mod", 7 нацело 3, -7 нацело 3, 7 нацело -3, -7 нацело -3, -7 % 3, 7 % -3, -7 % -3)
    печатать("floats", 7.5 нацело 2.0, -7.5 % 3.0, 7.5 % -3.0)
    печатать("big div", большой нацело 3, большой % 3)
    печатать("shifts", большой << 2, большой >> 2, -2 >> 1, -2 << 3)
    печатать("bits", ~0, ~(-1), 12 & 10, 12 | 10, 12 ^ 10, -5 & 3, -5 | 3, -5 ^ 3)
    печатать("precedence", 1 | 2 & 4, 1 << 2 + 1)
конец

импорт "ресурсы"
импорт "test_resource"
пусть ресурс = test_resource.создать()
test_resource.проверить(ресурсы.открыт(ресурс))
попробовать
    пусть результат = 1 нацело 0
перехватить ошибка
    test_resource.проверить(истина)
всегда
    test_resource.проверить(ресурсы.закрыть(ресурс))
конец
test_resource.проверить(не ресурсы.открыт(ресурс))
попробовать
    ресурсы.открыт(1)
перехватить ошибка
    test_resource.проверить(истина)
конец

пусть x = 7
печатать(x)
x = "Киртон"
печатать(x)
x = истина
печатать(x)
x = пусто
печатать(x)
x = 9223372036854775808
печатать(x)
x = x + 2
печатать(x)

функция пример() {
    пусть v = 3
    печатать(v)
    v = "привет"
    печатать(v)
    v = ложь
    печатать(v)
    v = пусто
    печатать(v)
}
пример()

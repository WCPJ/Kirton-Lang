импорт память
импорт внешний
импорт ресурсы
импорт test_resource

функция main()
    пусть загружено = внешний.загрузить(test_resource.путь_плагина())
    test_resource.проверить(загружено == истина)

    пусть схема = память.структура("здоровье", "целое32", "идентификатор", "целое64", "скорость", "число64")
    пусть область = память.создать(4096)
    пусть игрок = память.запись(область, схема)
    игрок.здоровье = 42
    игрок.идентификатор = 9007199254740993
    игрок.скорость = 2.5

    пусть точное = внешний.вызвать("структуры", "проверить", игрок)
    test_resource.проверить(точное == 9007199254740993)
    пусть копия = внешний.вызвать("структуры", "копировать", игрок)
    test_resource.проверить(копия.идентификатор == точное и игрок.здоровье == 42)

    test_resource.проверить(внешний.вызвать("структуры", "классифицировать_f64", нан()) == 1)
    test_resource.проверить(внешний.вызвать("структуры", "классифицировать_f64", беск()) == 2)

    попробовать
        внешний.вызвать("структуры", "вернуть_nan")
        test_resource.проверить(ложь)
    перехватить ошибка
        test_resource.проверить(истина)
    конец

    test_resource.проверить(внешний.вызвать("структуры", "классифицировать_f64", нан()) == 1)
    test_resource.проверить(внешний.вызвать("структуры", "классифицировать_f64", беск()) == 2)

    попробовать
        внешний.вызвать("структуры", "неверная_схема", игрок)
        test_resource.проверить(ложь)
    перехватить ошибка
        test_resource.проверить(истина)
    конец

    попробовать
        внешний.вызвать("структуры", "плохая_запись", игрок)
        test_resource.проверить(ложь)
    перехватить ошибка
        test_resource.проверить(истина)
    конец

    попробовать
        внешний.вызвать("структуры", "вернуть_nan")
        test_resource.проверить(ложь)
    перехватить ошибка
        test_resource.проверить(истина)
    конец

    пусть ресурс = test_resource.создать()
    пусть новое = внешний.вызвать("структуры", "увеличить", ресурс)
    test_resource.проверить(новое == 17 и ресурсы.открыт(ресурс))
    пусть возвращенный = внешний.вызвать("структуры", "вернуть_ресурс", ресурс)
    test_resource.проверить(ресурсы.открыт(возвращенный))

    попробовать
        внешний.вызвать("структуры", "подделать_ресурс", ресурс)
        test_resource.проверить(ложь)
    перехватить ошибка
        test_resource.проверить(истина)
    всегда
        test_resource.проверить(ресурсы.закрыть(возвращенный))
    конец
    test_resource.проверить(не ресурсы.открыт(ресурс))
конец

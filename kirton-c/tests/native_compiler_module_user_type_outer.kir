модуль тип_снаружи
импорт "native_compiler_module_user_type_inner" как внутри
структура СоставнойУзел { вложенный: список имя: строка }
функция собрать(значение) {
    вернуть СоставнойУзел(вложенный: [внутри.создать_внутри(значение)], имя: "обёртка")
}
функция сравнить_из_глубины() {
    вернуть внутри.сравнить_цвет(внутри.взять_цвет())
}

пусть x = пусто
печатать(пусто)
печатать(x == пусто)
печатать(пусто != пусто)
печатать(x != 0)
печатать(не x)
печатать(пусто или истина)
печатать(пусто и (1 / 0))
функция воспроизвести(v) {
    печатать(v)
}
воспроизвести(пусто)
функция вернуть_аргумент(a) {
    вернуть a
}
печатать(вернуть_аргумент(x))
если x {
    печатать("неверно")
} иначе {
    печатать("верно")
}

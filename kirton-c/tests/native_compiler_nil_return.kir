функция без_возврата() {
    пусть x = 3
}
функция явное_пусто() {
    вернуть пусто
}
функция короткое() {
    вернуть
}
функция ветки(n) {
    если n {
        вернуть пусто
    }
}
печатать(без_возврата())
печатать(явное_пусто())
печатать(короткое())
печатать(ветки(истина))
печатать(ветки(ложь))
печатать(не без_возврата())

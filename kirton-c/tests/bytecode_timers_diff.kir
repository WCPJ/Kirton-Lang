функция main()
    таймеры_очистить()
    если текущее_время_мс() > 0 то
        печатать("TIMERS_CLOCK_OK")
    иначе
        печатать("TIMERS_CLOCK_FAIL")
    конец

    пусть id = таймер_после(60000)
    пусть info = таймер_инфо(id)
    пусть ожидание = таймер_следующее_ожидание()
    пусть нет_событий = таймеры_шаг()

    если id > 0 и info.активен == истина и ожидание > 0 и список_длина(нет_событий) == 0 то
        печатать("TIMERS_CREATE_OK")
    иначе
        печатать("TIMERS_CREATE_FAIL")
    конец

    если таймер_после("ошибка") == 0 и таймер_отменить(999999) == ложь то
        печатать("TIMERS_INVALID_OK")
    иначе
        печатать("TIMERS_INVALID_FAIL")
    конец

    пусть одноразовый = таймер_после(5)
    ждать_мс(15)
    пусть сработали = таймеры_шаг()
    если список_длина(сработали) == 1 и сработали[0] == одноразовый то
        печатать("TIMERS_POLL_OK")
    иначе
        печатать("TIMERS_POLL_FAIL")
    конец

    пусть повторный = таймер_каждый(5)
    ждать_мс(15)
    пусть повторы = таймеры_шаг()
    если повторный > 0 и список_длина(повторы) >= 1 и повторы[0] == повторный то
        печатать("TIMERS_REPEAT_OK")
    иначе
        печатать("TIMERS_REPEAT_FAIL")
    конец
    таймер_отменить(повторный)

    если таймер_отменить(id) == истина и таймер_следующее_ожидание() == -1 то
        печатать("TIMERS_CANCEL_OK")
    иначе
        печатать("TIMERS_CANCEL_FAIL")
    конец
    таймеры_очистить()
конец

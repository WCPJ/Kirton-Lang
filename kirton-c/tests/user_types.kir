структура Игрок
    имя: строка
    здоровье: целое
конец

перечисление Состояние
    ожидание
    активно
    завершено
конец

перечисление Процесс
    ожидание
    активно
    завершено
конец

пусть игрок = Игрок(имя: "Ада", здоровье: 100)
игрок.здоровье = 90
пусть состояние = Состояние.активно
пусть тот_же_игрок = игрок
пусть похожий_игрок = Игрок(имя: "Ада", здоровье: 90)
пусть identity_верна = тот_же_игрок == игрок и похожий_игрок != игрок
пусть enum_identity_верна = Состояние.активно == Состояние.активно и
    Состояние.активно != Процесс.активно
пусть цикл = 0
пока цикл < 350
    пусть временный = Игрок(имя: "временный", здоровье: цикл)
    цикл = цикл + 1
конец
если игрок.имя == "Ада" и игрок.здоровье == 90 и
   состояние == Состояние.активно и состояние != Состояние.ожидание и
   identity_верна и enum_identity_верна то
    печатать("USER_TYPES_OK")
иначе
    печатать("USER_TYPES_FAIL")
конец

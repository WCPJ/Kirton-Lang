пусть шаг = 0
пусть сумма = 0
пока шаг < 4
    шаг = шаг + 1
    если шаг == 2 то
        продолжить
    конец
    если шаг == 4 то
        прервать
    конец
    сумма = сумма + шаг
конец

пусть посещено = 0
для каждого внешний в [1, 2, 3]
    для каждого внутренний в [1, 2]
        посещено = посещено + 1
        прервать
    конец
конец

пусть остаток = ""
для каждого знак в "ab"
    если знак == "a" то
        продолжить
    конец
    остаток = остаток + знак
конец

функция вернуть_из_цикла()
    пока истина
        для каждого значение в [7]
            вернуть значение
        конец
    конец
    вернуть 0
конец

пусть возвращено = вернуть_из_цикла()
если сумма == 4 и посещено == 3 и остаток == "b" и возвращено == 7 то
    печатать("LOOP_CONTROL_OK")
иначе
    печатать("LOOP_CONTROL_FAIL", сумма, посещено, остаток, возвращено)
конец

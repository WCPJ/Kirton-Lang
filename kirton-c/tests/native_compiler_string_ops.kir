пусть левая = "Кир"
пусть правая = "тон"
печатать(левая + правая)
печатать("Киртон" == (левая + правая))
печатать("Киртон" != "Киртон")
печатать("Киртон" != "другой")
печатать("" == "")
печатать(("Привет, " + "мир") == "Привет, мир")

функция соединить(а, б) {
    вернуть а + б
}
печатать(соединить("🧭", " Киртон"))

пусть слово = "начало"
функция дополнить() {
    слово = слово + "-конец"
    вернуть слово
}
печатать(дополнить())
печатать(слово == "начало-конец")

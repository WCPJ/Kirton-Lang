импорт "failure" как неисправность из "bytecode_modules"
попробовать {
    неисправность.сломать()
} перехватить ошибка {
    если ошибка.код == "runtime" и ошибка.сообщение == "Деление на ноль" {
        печатать("MODULE_EXCEPTION_OK")
    } иначе {
        печатать("MODULE_EXCEPTION_MISMATCH")
    }
} всегда {
    печатать("MODULE_EXCEPTION_FINALLY")
}

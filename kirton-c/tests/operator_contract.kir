пусть вызовов = 0

функция отметить()
    вызовов = вызовов + 1
    вернуть истина
конец

пусть ложное_и = ложь и отметить()
пусть истинное_или = истина или отметить()
пусть короткое_замыкание = вызовов == 0

пусть правая_и = истина и отметить()
пусть правая_или = ложь или отметить()
пусть оба_аргумента = вызовов == 2 и правая_и и правая_или

пусть приоритеты =
    10 - 2 * 3 == 4 и
    20 / 2 / 2 == 5 и
    3 << 1 & 5 == 4 и
    1 | 3 ^ 1 & 3 == 3 и
    1 < 2 == истина и
    истина или ложь и ложь

пусть цикл_a = [пусто]
пусть цикл_b = [пусто]
цикл_a[0] = цикл_a
цикл_b[0] = цикл_b
пусть циклы_равны = цикл_a == цикл_b

если короткое_замыкание и оба_аргумента и приоритеты и циклы_равны то
    печатать("OPERATOR_CONTRACT_OK")
иначе
    печатать("OPERATOR_CONTRACT_FAIL")
конец

функция добавить(x) { вернуть x + "!" }
печатать(добавить("да"))
печатать(добавить(12))
функция вычислить(x) { вернуть x - 1 }
печатать(вычислить(8))
печатать(вычислить("нет"))
функция сравнить(x) { вернуть x < 5 }
печатать(сравнить(2))
печатать(сравнить("строка"))
функция унарный(x) { вернуть -x }
печатать(унарный(3))
печатать(унарный("тест"))

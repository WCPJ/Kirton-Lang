функция identity(x) { вернуть x }
функция make(flag) {
    если flag { вернуть ["first", 9223372036854775808] }
    вернуть {"n": 5}
}
функция update(x) {
    x[0] = x[0] + 10
    вернуть x
}
пусть a = [1, 2]
пусть b = identity(a)
печатать(update(b)[0])
пусть arr = make(истина)
пусть obj = make(ложь)
печатать(arr[0], arr[1], obj["n"])
пусть twice = identity(identity({"ключ": [9]}))
печатать(twice["ключ"][0], a[0])

импорт fs

функция main()
    пусть папка = окружение("KIRTON_BYTECODE_FS_DIR")
    пусть путь = путь_соединить(папка, "payload.txt")
    пусть создана_папка = fs.фс_создать_папку(папка)
    пусть записано = fs.фс_записать_текст(путь, "KIRTON_FS_PAYLOAD")
    пусть содержимое = fs.фс_прочитать_текст(путь)
    пусть файлы = fs.фс_список(папка)

    если создана_папка и записано и fs.фс_есть(путь) и содержимое == "KIRTON_FS_PAYLOAD" и список_длина(файлы) == 1 и файлы[0] == "payload.txt" то
        печатать("FS_READ_WRITE_LIST_OK")
    иначе
        печатать("FS_READ_WRITE_LIST_FAIL")
    конец

    пусть удален_файл = удалить_файл(путь)
    пусть удалена_папка = удалить_папка(папка)
    если удален_файл и удалена_папка и fs.фс_есть(путь) == ложь то
        печатать("FS_DELETE_OK")
    иначе
        печатать("FS_DELETE_FAIL")
    конец

    если fs.фс_записать_текст(42, "invalid path") == ложь то
        печатать("FS_INVALID_ARGUMENT_OK")
    иначе
        печатать("FS_INVALID_ARGUMENT_FAIL")
    конец
конец

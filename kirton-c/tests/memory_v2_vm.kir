импорт память

функция создать_буфер()
    пусть область = память.создать(64)
    пусть буфер = память.выделить(область, 4, 4)
    память.записать(буфер, 2, 173)
    вернуть буфер
конец

функция принять_буфер(значение)
    вернуть память.действителен(значение)
конец

функция создать_список_с_буфером()
    пусть область = память.создать(32)
    пусть буфер = память.выделить(область, 8)
    память.записать(буфер, 6, 222)
    вернуть [буфер, [1, 2, 3]]
конец

пусть элементы = [2, 4, 6]
печатать(список_получить(элементы, 0), список_получить(элементы, 9, "нет"))
печатать(список_вставить(элементы, 1, 3), элементы)
печатать(список_удалить(элементы, 2), элементы)
пусть таблица = {"а": 10, "б": 20}
печатать(словарь_получить(таблица, "а"), словарь_получить(таблица, "нет", "замена"))
печатать(словарь_удалить(таблица, "а"), словарь_есть(таблица, "а"), словарь_длина(таблица))
печатать(сумма([1, 2, 3, "пусто", 9223372036854775808]))
печатать(произведение([2, 3, 4]), произведение([]))

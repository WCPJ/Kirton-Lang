структура Игрок {
    имя: строка
    здоровье: целое
}

перечисление Состояние {
    ожидание
    активно
}

функция сложить(a, b) {
    если a > b {
        вернуть a + b
    } иначе {
        вернуть b - a
    }
}

функция смешанная_новая() {
    функция legacy_вложенная()
        вернуть 7
    конец
    вернуть legacy_вложенная()
}

функция смешанная_старая()
    если истина {
        вернуть 9
    }
конец

пусть сумма_проверка = сложить(4, 3)
пусть значение = 0
пока значение < 3 {
    значение = значение + 1
}
пусть перебор = 0
для каждого элемент в [1, 2, 3] {
    перебор = перебор + элемент
}
пусть поймано = ложь
пусть очищено = ложь
попробовать {
    пусть ошибка = 1 нацело 0
} перехватить проблема {
    поймано = проблема.код == "runtime"
} всегда {
    очищено = истина
}
пусть игрок = Игрок(имя: "Ада", здоровье: 100)
пусть состояние = Состояние.активно
пусть словарь = {"ключ": 1}

если сумма_проверка == 7 и значение == 3 и перебор == 6 и
   смешанная_новая() == 7 и смешанная_старая() == 9 и
   игрок.здоровье == 100 и состояние == Состояние.активно и словарь["ключ"] == 1 и поймано и очищено {
    печатать("BRACE_SYNTAX_OK")
} иначе {
    печатать("BRACE_SYNTAX_FAIL")
}

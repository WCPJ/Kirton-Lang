импорт память
импорт test_resource

пусть область = память.создать(16777216)
пусть данные = ["строка для teardown", {"ключ": "значение", "целое": 123456789012345678901234567890123456789 + 1}]
пусть ресурс = test_resource.создать()

функция создать_замыкание(значение) {
    пусть захват = значение
    функция получить() {
        вернуть захват
    }
    вернуть получить
}

пусть замыкание = создать_замыкание(данные[1]["целое"])

функция main() {
    если замыкание() != 123456789012345678901234567890123456790 то
        бросить "ошибка замыкания"
    конец
}

модуль типA
структура Данные { значение: целое }
структура Пара { данные: Данные }
перечисление Режим { готово ожидание }
функция создать(x) {
    вернуть Пара(данные: Данные(значение: x))
}
функция режим() { вернуть Режим.готово }
функция проверить(значение) { вернуть значение == Режим.готово }
функция обернуть(чужие_данные) {
    вернуть Пара(данные: чужие_данные)
}
функция данные(x) { вернуть Данные(значение: x) }

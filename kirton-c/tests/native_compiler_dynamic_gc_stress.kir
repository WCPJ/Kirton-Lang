пусть g = "Начало 🐢"
пусть сохранено = g
функция изменить(n) {
    если n % 2 == 0 {
        g = "Другой 🧭"
    } иначе {
        g = 9223372036854775808 + n
    }
    вернуть g
}
пусть счёт = 0
пока счёт < 2000 {
    изменить(счёт)
    счёт = счёт + 1
}
печатать(сохранено)
печатать(g)
печатать(изменить(2000))
печатать(изменить(2001))
печатать(сохранено)

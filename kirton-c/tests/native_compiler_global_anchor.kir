пусть глобальная = 9223372036854775808
функция изменить(раз) {
    пусть индекс = 0
    пока индекс < раз {
        глобальная = глобальная + 1
        индекс = индекс + 1
    }
    вернуть глобальная
}

функция сохранить(старое, новое) {
    печатать(старое)
    печатать(новое)
}
сохранить(глобальная, изменить(5000))
печатать(глобальная)

пусть текст = "до"
функция изменить_текст() {
    текст = текст + "-после"
    вернуть текст
}
функция сохранить_текст(старое, новое) {
    печатать(старое)
    печатать(новое)
}
сохранить_текст(текст, изменить_текст())
печатать(текст)

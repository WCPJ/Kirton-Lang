пусть значение = 9223372036854775808
пусть копия = значение

функция обновить() {
    пусть шаг = 0
    пока шаг < 64 {
        значение = значение + 1
        шаг = шаг + 1
    }
    вернуть значение
}

функция проверить(старое, новое) {
    печатать(старое)
    печатать(новое)
    вернуть старое + новое
}

печатать(проверить(копия, обновить()))
печатать(значение)
печатать(копия)

пусть имя = "Начало"
пусть сохранённое_имя = имя
функция заменить_имя() {
    имя = "Конец"
    вернуть имя
}
функция показать_имена(старое, новое) {
    печатать(старое)
    печатать(новое)
}
показать_имена(сохранённое_имя, заменить_имя())
печатать(имя)
печатать(сохранённое_имя)

функция создать_пару() {
  пусть значение = 0
  функция увеличить() {
    значение = значение + 1
    вернуть значение
  }
  функция прочитать() {
    вернуть значение
  }
  вернуть [увеличить, прочитать]
}

функция применить(f) {
  вернуть f()
}

функция создать_рекурсивное() {
  функция чётное(n) {
    если n == 0 { вернуть истина }
    вернуть нечётное(n - 1)
  }
  функция нечётное(n) {
    если n == 0 { вернуть ложь }
    вернуть чётное(n - 1)
  }
  вернуть чётное
}

пусть пара = создать_пару()
пусть увеличение = пара[0]
пусть чтение = пара[1]
пусть рекурсивное = создать_рекурсивное()
если увеличение() == 1 и чтение() == 1 и
   применить(увеличение) == 2 и чтение() == 2 и
   рекурсивное(20) == истина то
  печатать("CLOSURE_BYTECODE_OK")
иначе
  печатать("CLOSURE_BYTECODE_FAIL")
конец

функция создать_счётчик(начало)
    пусть значение = начало
    функция следующий()
        значение = значение + 1
        вернуть значение
    конец
    вернуть следующий
конец

пусть счётчик = создать_счётчик(40)
если счётчик() != 41 то
    печатать("CLOSURE_FAIL_FIRST")
конец
если счётчик() != 42 то
    печатать("CLOSURE_FAIL_STATE")
конец
пусть итерации = 0
пока итерации < 20000
    счётчик()
    итерации = итерации + 1
конец
если счётчик() != 20043 то
    печатать("CLOSURE_FAIL_GC")
конец

функция внешний_вызов()
    пусть число = 7
    функция захватить()
        вернуть число
    конец
    вернуть захватить
конец

пусть сохранённое = внешний_вызов()
если сохранённое() != 7 то
    печатать("CLOSURE_FAIL_LIFETIME")
конец

функция взаимная(число)
    пусть ответ = чётное(число)
    функция нечётное(n)
        если n == 0 то
            вернуть ложь
        конец
        вернуть чётное(n - 1)
    конец
    функция чётное(n)
        если n == 0 то
            вернуть истина
        конец
        вернуть нечётное(n - 1)
    конец
    вернуть ответ
конец
если взаимная(20) != истина то
    печатать("CLOSURE_FAIL_MUTUAL_HOIST")
конец
печатать("CLOSURE_OK")

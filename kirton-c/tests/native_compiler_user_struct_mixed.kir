структура Контейнер {
    имя: строка
    данные: список
    таблица: словарь
}
перечисление Режим { начало готово }
структура Событие { режим: Режим значение: целое }
функция обновить(объект, значение) {
    объект.данные[0] = значение
    объект.таблица.запись = значение
    вернуть объект
}
пусть данные = [1, [2]]
пусть таблица = {"запись": 1}
пусть контейнер = Контейнер(имя: "Киртон 🧭", данные: данные, таблица: таблица)
пусть событие = Событие(режим: Режим.начало, значение: 9223372036854775808)
пусть копия = обновить(контейнер, 100)
событие.режим = Режим.готово
печатать(контейнер.имя, копия == контейнер, данные[0], таблица.запись)
печатать(событие.режим == Режим.готово, событие.значение)

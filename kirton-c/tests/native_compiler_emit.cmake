if(NOT DEFINED KIRTON OR NOT DEFINED SOURCE OR NOT DEFINED IR)
  message(FATAL_ERROR "KIRTON, SOURCE and IR are required")
endif()
get_filename_component(ir_dir "${IR}" DIRECTORY)
file(MAKE_DIRECTORY "${ir_dir}")
execute_process(COMMAND "${KIRTON}" --emit-llvm "${SOURCE}" -o "${IR}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "LLVM emission failed: ${error}")
endif()
file(READ "${IR}" ir_text)
foreach(fragment IN ITEMS "define i32 @main()" "@kirton_native_runtime_new" "@kirton_native_numeric_binary" "@kirton_native_i64" "@kirton_native_print_value")
  string(FIND "${ir_text}" "${fragment}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "generated LLVM IR is missing [${fragment}]")
  endif()
endforeach()

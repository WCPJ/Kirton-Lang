импорт память
пусть схема = память.структура("здоровье", "целое32", "идентификатор", "целое64", "скорость", "число64")
пусть область = память.создать(4096)
пусть герой = память.запись(область, схема)
герой.здоровье = 42
герой.идентификатор = 9007199254740993
герой.скорость = 2.5
печатать(герой.здоровье)
печатать(герой.идентификатор)
печатать(герой.скорость)
печатать(память.занято(область) > 0)

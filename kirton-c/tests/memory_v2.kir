импорт память

пусть область = память.создать(128)
пусть первый = память.выделить(область, 4, 8)
пусть второй = память.выделить(область, 8, 16)
память.записать(первый, 0, 251)
память.записать(второй, 7, 255)
пусть правильно = память.емкость(область) == 128 и память.занято(область) == 24
правильно = правильно и память.длина(первый) == 4 и память.прочитать(первый, 0) == 251
правильно = правильно и память.прочитать(второй, 7) == 255

пусть устаревший = первый
память.сбросить(область)
правильно = правильно и не память.действителен(устаревший)
правильно = правильно и память.занято(область) == 0
пусть новый = память.выделить(область, 2, 1)
правильно = правильно и память.действителен(новый) и память.прочитать(новый, 0) == 0
память.закрыть(область)
правильно = правильно и не память.действителен(новый)
если правильно то
    печатать("MEMORY_V2_OK")
иначе
    печатать("MEMORY_V2_FAIL")
конец

импорт память
функция создать_запись()
    пусть схема = память.структура("номер", "целое64", "вес", "число64")
    пусть область = память.создать(64)
    пусть запись = память.запись(область, схема)
    запись.номер = 9007199254740993
    запись.вес = 1.5
    вернуть запись
конец
функция использовать_запись(запись)
    вернуть запись.номер
конец

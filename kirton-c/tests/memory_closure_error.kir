импорт память

функция создать_счётчик_буфера()
    пусть область = память.создать(64)
    пусть буфер = память.выделить(область, 1)
    память.записать(буфер, 0, 10)
    функция увеличить()
        пусть значение = память.прочитать(буфер, 0) + 1
        память.записать(буфер, 0, значение)
        вернуть память.прочитать(буфер, 0)
    конец
    вернуть увеличить
конец

пусть увеличить = создать_счётчик_буфера()
пусть ошибка_перехвачена = ложь
пусть в_очистке = 0
попробовать
    пусть значение = 1 нацело 0
перехватить ошибка
    ошибка_перехвачена = ошибка.код == "runtime"
всегда
    в_очистке = увеличить()
конец

пусть шаг = 0
пока шаг < 2000
    пусть мусор = [шаг, {"строка": "временное"}]
    шаг = шаг + 1
конец

если ошибка_перехвачена и в_очистке == 11 и увеличить() == 12 то
    печатать("MEMORY_CLOSURE_ERROR_OK")
иначе
    печатать("MEMORY_CLOSURE_ERROR_FAIL")
конец

структура Данные { значение: целое }
перечисление Режим { готово ожидание }
импорт "native_compiler_module_same_type_a" как А
импорт "native_compiler_module_same_type_b" как Б
пусть a = А.создать(5)
пусть b = Б.создать(7)
пусть корень = Данные(значение: 9)
печатать(a.данные.значение)
печатать(b.данные.значение)
печатать(корень.значение)
печатать(А.проверить(А.режим()))
печатать(Б.проверить(Б.режим()))
печатать(А.проверить(Б.режим()))
печатать(Б.проверить(А.режим()))
печатать(А.режим() == Б.режим())

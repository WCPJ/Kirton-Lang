пусть а = список_пустой()
печатать(список_длина(а))
печатать(список_добавить(а, 1))
печатать(список_добавить(а, 2))
печатать(список_длина(а), а[0], а[1])
пусть сумма = 0
для каждого элемент в а {
    сумма = сумма + элемент
    если элемент == 2 { список_добавить(а, 3) }
}
печатать(сумма, список_длина(а))
пусть словарь = словарь_пустой()
печатать(словарь_длина(словарь))
печатать(словарь_установить(словарь,"ключ", 8))
печатать(словарь_есть(словарь,"ключ"), словарь_длина(словарь), словарь["ключ"])
печатать(словарь_установить(словарь,"ключ", пусто))
печатать(словарь_есть(словарь,"ключ"), словарь_длина(словарь))
печатать(список_добавить(7,9), список_длина(пусто))

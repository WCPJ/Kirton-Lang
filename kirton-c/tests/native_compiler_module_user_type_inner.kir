модуль тип_внутри
структура ВнутреннийУзел { имя: строка значение: целое }
перечисление ЦветУзла { красный синий }
функция создать_внутри(значение) {
    вернуть ВнутреннийУзел(имя: "узел", значение: значение)
}
функция взять_цвет() {
    вернуть ЦветУзла.синий
}
функция сравнить_цвет(x) {
    вернуть x == ЦветУзла.синий
}

пусть порядок = 0

функция аргумент(номер)
    порядок = порядок * 10 + номер
    вернуть номер
конец

функция сложить(первый, второй)
    вернуть первый + второй
конец

функция сумма_до(n)
    если n <= 0 то
        вернуть 0
    конец
    вернуть n + сумма_до(n - 1)
конец

функция без_возврата()
    пусть локальное = 1
конец

функция пустой_возврат()
    вернуть
конец

пусть успешно = сложить(аргумент(1), аргумент(2)) == 3
успешно = успешно и порядок == 12
успешно = успешно и сумма_до(10) == 55
успешно = успешно и без_возврата() == пусто
успешно = успешно и пустой_возврат() == пусто

если успешно то
    печатать("FUNCTION_CONTRACT_OK")
иначе
    печатать("FUNCTION_CONTRACT_FAIL")
конец

функция test(i) {
  пусть результат = "начало"
  попробовать {
     пусть список = [1]
     если i == 1 {
         печатать(список[10])
     } иначе {
         печатать("тело")
     }
     результат = "успех"
  } перехватить ошибка {
     результат = ошибка.код
  } всегда {
     результат = результат + "!"
  }
  вернуть результат
}
печатать(test(1))
печатать(test(2))
пусть массив = [0]
попробовать {
  попробовать {
    печатать(массив[50])
  } перехватить первая {
    печатать(массив[51])
  } всегда {
    печатать("inner finally")
  }
} перехватить вторая {
  печатать(вторая.код)
} всегда {
  печатать("outer finally")
}

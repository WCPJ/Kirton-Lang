пусть текст = "  Привет, мир!  "
пусть чисто = строка_обрезать(текст)
печатать(чисто)
печатать(строка_длина(чисто))
печатать(начинается_с(чисто, "При"), заканчивается_на(чисто, "!"))
печатать(строка_заменить(чисто, "мир", "Киртон"))
печатать(строка_найти("ababa", "ba"))
печатать(строка_разделить("а,б,в", ","))
печатать(срез("abcdef", 1, 3), в_верхнем("ok"))

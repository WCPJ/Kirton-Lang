фс_записать_текст("tmp_invalid_import.кир", "функция сломанная(")
пусть перехвачено = 0
попробовать
    импорт "tmp_invalid_import" из "."
перехватить ошибка
    перехвачено = 1
всегда
    удалить_файл("tmp_invalid_import.кир")
конец
если перехвачено == 1 то
    печатать("CATCH_IMPORT_ERROR_OK")
иначе
    печатать("CATCH_IMPORT_ERROR_FAIL")
конец

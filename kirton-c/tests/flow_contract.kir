импорт память

пусть посещено_пустых = 0
для каждого элемент в []
    посещено_пустых = посещено_пустых + 1
конец

пусть список = [1, 2]
пусть посещено_списка = 0
пусть сумма_списка = 0
для каждого элемент в список
    посещено_списка = посещено_списка + 1
    сумма_списка = сумма_списка + элемент
    если элемент == 1 то
        список[1] = 4
        список_добавить(список, 3)
    конец
конец

пусть строка = "А🙂Б"
пусть собранная_строка = ""
пусть посещено_строки = 0
для каждого символ в строка
    собранная_строка = собранная_строка + символ
    посещено_строки = посещено_строки + 1
конец

пусть область = память.создать(32)
пусть пустой_массив = память.массив(область, "байт", 0)
для каждого байт в пустой_массив
    посещено_пустых = посещено_пустых + 1
конец

пусть фигурный_результат = 0
если истина {
    фигурный_результат = фигурный_результат + 1
}
пока ложь {
    фигурный_результат = фигурный_результат + 100
}
для каждого число в [2, 3] {
    фигурный_результат = фигурный_результат + число
}

если посещено_пустых == 0 и посещено_списка == 3 и сумма_списка == 8 и
   посещено_строки == 3 и собранная_строка == строка и
   фигурный_результат == 6 то
    печатать("FLOW_CONTRACT_OK")
иначе
    печатать("FLOW_CONTRACT_FAIL")
конец

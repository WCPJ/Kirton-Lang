функция большое()
    вернуть 123456789012345678901234567890123456789
конец

функция проверить(значение)
    пусть счет = 0
    для каждого число в значение
        счет = счет + 1
    конец
    вернуть счет
конец

пусть сохранено = [большое(), {"число": большое()}]
пусть счетчик = 0
пока счетчик < 12000
    пусть циклический = [0]
    циклический[0] = циклический
    пусть временное = [большое() + счетчик, {"строка": "данные"}]
    пусть накопитель = проверить([1, 2, 3])
    счетчик = счетчик + 1
конец

если сохранено[0] == 123456789012345678901234567890123456789 и сохранено[1].число == сохранено[0] и накопитель == 3 то
    печатать("GC_RUNTIME_OK")
иначе
    печатать("GC_RUNTIME_FAIL")
конец

функция получить_сохраненное()
    вернуть сохранено[0]
конец

функция дать_временное()
    вернуть [большое() + 1, {"текст": "живое"}]
конец

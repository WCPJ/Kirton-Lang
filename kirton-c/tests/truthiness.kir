импорт память

функция создать_замыкание()
    функция замыкание()
        вернуть пусто
    конец
    вернуть замыкание
конец

структура Точка
    x: целое
конец

перечисление Состояние
    готово
конец

функция проверить(условие, сообщение)
    если не условие то
        печатать("TRUTHINESS_FAIL", сообщение)
    конец
конец

проверить(не пусто, "пусто должно быть ложным")
проверить(не ложь, "ложь должна быть ложной")
проверить(не 0, "целый ноль должен быть ложным")
проверить(не 0.0, "вещественный ноль должен быть ложным")
проверить(не "", "пустая строка должна быть ложной")
проверить(не [], "пустой список должен быть ложным")
проверить(не {}, "пустой словарь должен быть ложным")

проверить(истина, "истина должна быть истинной")
проверить(1, "ненулевое целое должно быть истинным")
проверить(-0.5, "ненулевое вещественное должно быть истинным")
проверить("x", "непустая строка должна быть истинной")
проверить([пусто], "непустой список должен быть истинным")
проверить({"x": пусто}, "непустой словарь должен быть истинным")
проверить(создать_замыкание(), "функция должна быть истинной")
проверить(Точка(x: 1), "структура должна быть истинной")
проверить(Состояние.готово, "значение перечисления должно быть истинным")

пусть область = память.создать(64)
пусть буфер = память.выделить(область, 8)
пусть массив = память.массив(область, "целое32", 2)
пусть схема = память.структура("значение", "целое32")
пусть запись = память.запись(область, схема)

проверить(область, "арена должна быть истинной")
проверить(буфер, "действительный буфер должен быть истинным")
проверить(массив, "действительный типизированный массив должен быть истинным")
проверить(схема, "схема записи должна быть истинной")
проверить(запись, "действительная запись должна быть истинной")

память.закрыть(область)
проверить(не память.действителен(буфер), "буфер должен стать недействительным")
проверить(не память.действителен_массив(массив), "массив должен стать недействительным")
проверить(не память.действительна_запись(запись), "запись должна стать недействительной")
проверить(буфер, "недействительный буфер остаётся истинным значением")
проверить(массив, "недействительный массив остаётся истинным значением")
проверить(запись, "недействительная запись остаётся истинным значением")

печатать("TRUTHINESS_OK")

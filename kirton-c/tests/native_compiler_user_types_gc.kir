структура Узел { имя: строка данные: список }
перечисление Состояние { готово активно }
функция обновить(узел, состояние) {
    узел.имя = "изменено"
    узел.данные[1] = состояние
    вернуть узел
}
пусть состояние = Состояние.активно
пусть узлы = [пусто, состояние]
пусть корень = Узел(имя: "начало", данные: узлы)
узлы[0] = корень
пусть i = 0
пока i < 700 {
    пусть мусор = Узел(имя: "мусор", данные: [i, Состояние.готово])
    i = i + 1
}
пусть тот_же = обновить(корень, состояние)
печатать(корень == тот_же, корень.имя, корень.данные[0] == корень, корень.данные[1] == Состояние.активно)

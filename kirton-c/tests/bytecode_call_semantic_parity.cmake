execute_process(COMMAND "${KIRTON}" "${SOURCE}"
  RESULT_VARIABLE ast_rc OUTPUT_VARIABLE ast_out ERROR_VARIABLE ast_err ENCODING UTF-8)
execute_process(COMMAND "${KIRTON}" --bytecode "${SOURCE}"
  RESULT_VARIABLE bc_rc OUTPUT_VARIABLE bc_out ERROR_VARIABLE bc_err ENCODING UTF-8)

if(NOT ast_rc EQUAL bc_rc)
  message(FATAL_ERROR "AST/Bytecode exit status differs: AST=${ast_rc}, Bytecode=${bc_rc}; stderr AST=[${ast_err}] Bytecode=[${bc_err}]")
endif()
if(NOT ast_out STREQUAL bc_out)
  message(FATAL_ERROR "AST/Bytecode stdout differs: AST=[${ast_out}] Bytecode=[${bc_out}]; stderr AST=[${ast_err}] Bytecode=[${bc_err}]")
endif()

if(EXPECT_ERROR)
  if(ast_rc EQUAL 0)
    message(FATAL_ERROR "Expected both interpreters to reject this call; stdout=[${ast_out}]")
  endif()
  if(NOT ast_err MATCHES "${EXPECT_ERROR}" OR NOT bc_err MATCHES "${EXPECT_ERROR}")
    message(FATAL_ERROR "Diagnostic categories differ or are missing (expected '${EXPECT_ERROR}'; AST stderr=[${ast_err}]; Bytecode stderr=[${bc_err}])")
  endif()
else()
  if(NOT ast_rc EQUAL 0 OR ast_err OR bc_err)
    message(FATAL_ERROR "Expected successful execution with empty stderr; rc AST=${ast_rc}, Bytecode=${bc_rc}; stderr AST=[${ast_err}] Bytecode=[${bc_err}]")
  endif()
endif()

if(DEFINED EXPECT_PATTERN AND NOT ast_out MATCHES "${EXPECT_PATTERN}")
  message(FATAL_ERROR "Expected output/state pattern '${EXPECT_PATTERN}' was missing: [${ast_out}]")
endif()
if(FORBID_STDOUT AND ast_out MATCHES "${FORBID_STDOUT}")
  message(FATAL_ERROR "Unexpected side effect '${FORBID_STDOUT}' was observed: [${ast_out}]")
endif()
if(EXPECT_EMPTY_STDOUT AND NOT ast_out STREQUAL "")
  message(FATAL_ERROR "Expected no stdout side effects, got [${ast_out}]")
endif()

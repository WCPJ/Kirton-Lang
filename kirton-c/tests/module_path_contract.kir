импорт "tests/module_import_once.kir" как первый
импорт "tests/./module_import_once.kir" как второй
импорт "module_scope_a" как из_каталога из "tests"
импорт "tests/module_scope_a" как путь_без_суффикса
импорт module_search_choice как выбор

пусть кэш_един = первый.увеличить() == 1 и второй.увеличить() == 2
пусть пути_работают = из_каталога.значение() == 10 и
    путь_без_суффикса.значение() == 10 и выбор.источник() == "KIRTON_PATH"

если кэш_един и пути_работают то
    печатать("MODULE_PATH_CONTRACT_OK")
иначе
    печатать("MODULE_PATH_CONTRACT_FAIL")
конец

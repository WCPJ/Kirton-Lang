функция проверить(n) {
    пусть значения = [1, 2, 3, 4, 5]
    пусть s = 0
    пока n > 0 {
        n = n - 1
        для каждого v в значения {
            если v == 1 { продолжить }
            если v == 5 { прервать }
            пусть временный = [v, {"k": n}, "Ж🧭"]
            s = s + временный[0]
        }
    }
    вернуть s
}
печатать(проверить(400))

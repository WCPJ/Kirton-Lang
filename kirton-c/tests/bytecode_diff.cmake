if(DEFINED ENV{KIRTON_BYTECODE_FS_DIR})
  file(REMOVE_RECURSE "$ENV{KIRTON_BYTECODE_FS_DIR}")
endif()
execute_process(COMMAND "${KIRTON}" -e main "${SOURCE}" RESULT_VARIABLE ast_rc OUTPUT_VARIABLE ast_out ERROR_VARIABLE ast_err ENCODING UTF-8)
execute_process(COMMAND "${KIRTON}" --bytecode -e main "${SOURCE}" RESULT_VARIABLE bc_rc OUTPUT_VARIABLE bc_out ERROR_VARIABLE bc_err ENCODING UTF-8)
if(DEFINED ENV{KIRTON_BYTECODE_FS_DIR})
  file(REMOVE_RECURSE "$ENV{KIRTON_BYTECODE_FS_DIR}")
endif()
if(NOT ast_rc EQUAL 0 OR NOT bc_rc EQUAL 0)
  message(FATAL_ERROR "AST rc=${ast_rc}; bytecode rc=${bc_rc}; AST stderr=${ast_err}; bytecode stderr=${bc_err}")
endif()
if(NOT ast_out STREQUAL bc_out)
  message(FATAL_ERROR "AST and bytecode output differ. AST=[${ast_out}] bytecode=[${bc_out}]")
endif()
if(DEFINED EXPECT AND NOT ast_out MATCHES "${EXPECT}")
  message(FATAL_ERROR "Expected differential marker '${EXPECT}' was missing: ${ast_out}")
endif()

фс_записать_текст("tmp_scope_a.кир", "функция значение() вернуть 1 конец")
фс_записать_текст("tmp_scope_b.кир", "функция значение() вернуть 2 конец")
импорт "tmp_scope_a" как общий из "."

функция локальное_значение()
    импорт "tmp_scope_b" как общий из "."
    вернуть общий.значение()
конец

функция локальная_файловая_система()
    импорт "fs" как общий
    вернуть общий.фс_есть(".")
конец

печатать(локальное_значение(), общий.значение())
если локальная_файловая_система() == истина то
    печатать("SCOPED_NATIVE_OK")
иначе
    печатать("SCOPED_NATIVE_FAIL")
конец
печатать(общий.значение())

функция main()
    пусть id = картинка_загрузить("../data/test.bmp")
    пусть размер = картинка_размер(id)
    если id > 0 и размер[0] > 0 и размер[1] > 0 и картинка_пиксель(id, 0, 0) >= 0 то
        печатать("BITMAP_READ_OK")
    иначе
        печатать("BITMAP_READ_FAIL")
    конец

    если картинка_освободить(id) и картинка_размер(id)[0] == 0 и картинка_загрузить(42) == 0 то
        печатать("BITMAP_INVALID_OK")
    иначе
        печатать("BITMAP_INVALID_FAIL")
    конец
конец

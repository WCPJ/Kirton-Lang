функция увеличить(x) {
    вернуть x + 1
}

функция factorial(n) {
    если n <= 1 {
        вернуть 1
    }
    вернуть n * factorial(n - 1)
}
функция identity(value) {
    вернуть value
}

пусть счётчик = 9223372036854775807
функция следующий() {
    счётчик = счётчик + 1
    вернуть счётчик
}

пусть большое = 9223372036854775808
печатать(увеличить(большое))
печатать(identity(большое))
печатать(identity(42))
печатать(следующий())
печатать(следующий())
печатать(factorial(30))

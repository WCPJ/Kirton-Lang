импорт память
функция создать_буфер()
    пусть область = память.создать(64)
    вернуть память.выделить(область, 8, 8)
конец
функция создать_массив()
    пусть область = память.создать(64)
    вернуть память.массив(область, "целое64", 4)
конец
функция создать_запись()
    пусть схема = память.структура("номер", "целое64", "вес", "число64")
    пусть область = память.создать(64)
    вернуть память.запись(область, схема)
конец

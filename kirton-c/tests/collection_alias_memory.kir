функция добавить_через_функцию(данные)
    список_добавить(данные, 777)
конец

пусть исходный = [0]
пусть псевдоним = исходный
пусть индекс = 1
пока индекс < 40
    список_добавить(исходный, индекс)
    индекс = индекс + 1
конец
добавить_через_функцию(псевдоним)

пусть словарь = {}
пусть ссылка_на_словарь = словарь
словарь.к0 = 0
словарь.к1 = 1
словарь.к2 = 2
словарь.к3 = 3
словарь.к4 = 4
словарь.к5 = 5
словарь.к6 = 6
словарь.к7 = 7
словарь.к8 = 8
словарь.к9 = 9

пусть кольцо = [пусто]
кольцо[0] = кольцо
пусть ссылка_на_кольцо = кольцо
кольцо = пусто

если список_длина(исходный) == 41 и список_длина(псевдоним) == 41 и псевдоним[39] == 39 и исходный[40] == 777 и словарь_длина(ссылка_на_словарь) == 10 и ссылка_на_словарь.к9 == 9 и ссылка_на_кольцо == ссылка_на_кольцо[0] то
    печатать("COLLECTION_ALIAS_MEMORY_OK")
иначе
    печатать("COLLECTION_ALIAS_MEMORY_FAIL")
конец

пусть счётчик = 0
функция эффект() {
    счётчик = счётчик + 1
    вернуть истина
}
печатать(ложь и эффект())
печатать(истина или эффект())
печатать(счётчик)
печатать(истина и эффект())
печатать(ложь или эффект())
печатать(счётчик)
печатать("" или "Привет")
печатать("Привет" и "")
печатать(0 или 2)
печатать((2 и 3) или ложь)
печатать(9223372036854775808 и истина)
печатать(0 и (1 / 0))
печатать(не ложь)
печатать(не "")
печатать(не 0)
печатать(не 9223372036854775808)
печатать(не ("да" == "нет"))

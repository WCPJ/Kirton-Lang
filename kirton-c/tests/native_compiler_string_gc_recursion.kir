функция сохранить_имя(имя, глубина) {
    пусть сохранённое = имя
    пусть временная = "Временная строка 🌿"
    если глубина <= 0 {
        вернуть сохранённое
    }
    вернуть сохранить_имя(сохранённое, глубина - 1)
}

печатать(сохранить_имя("Привет, Киртон 🧭", 32))
печатать(сохранить_имя("Повторный вызов", 8))
печатать(сохранить_имя("Ещё один вызов", 8))

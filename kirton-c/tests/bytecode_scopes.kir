пусть outer = 100
пусть x = 5
функция helper() {
  пусть outer = 10
  печатать(outer)
}
функция main() {
  пусть x = 10
  если истина {
    пусть x = 30
    если истина {
      пусть x = 40
      печатать(x)
    }
    печатать(x)
    x = 21
  }
  печатать(x, outer)
  helper()
  печатать(outer)
  пусть i = 0
  пока i < 4 {
    пусть temporary = i + 5
    i = i + 1
  }
  печатать(temporary)
}

импорт память
функция создать_набор()
    пусть область = память.создать(4096)
    пусть буфер = память.выделить(область, 32, 8)
    пусть массив = память.массив(область, "целое64", 8)
    пусть схема = память.структура("номер", "целое64", "вес", "число64")
    пусть запись = память.запись(область, схема)
    вернуть [область, буфер, массив, запись]
конец

функция создать_пустой()
    пусть область = память.создать(0)
    пусть буфер = память.выделить(область, 0)
    вернуть [область, буфер]
конец

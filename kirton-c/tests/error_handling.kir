пусть обработок = 0
пусть очисток = 0

функция вызвать_ошибку()
    вернуть 1 нацело 0
конец

попробовать
    пусть результат = вызвать_ошибку()
перехватить ошибка
    если ошибка.код == "runtime" и ошибка.сообщение != "" и
       ошибка.файл != "" и ошибка.строка > 0 и ошибка.столбец > 0 и
       ошибка.стек[0]["функция"] == "вызвать_ошибку" то
        обработок = обработок + 1
    конец
всегда
    очисток = очисток + 1
конец

попробовать
    попробовать
        пусть значение = 1 нацело 0
    перехватить внутренняя
        печатать("INNER_CAUGHT")
        обработок = обработок + 1
    конец
    пусть продолжение = 5
перехватить внешняя
    печатать("OUTER_CAUGHT")
    печатать("ERROR_FAIL_NESTED")
всегда
    очисток = очисток + 1
конец

функция вернуть_с_очисткой()
    попробовать
        вернуть 17
    всегда
        очисток = очисток + 1
    конец
конец

пусть возвращено = вернуть_с_очисткой()
если обработок == 2 и очисток == 3 и возвращено == 17 то
    печатать("ERROR_HANDLING_OK")
иначе
    печатать("ERROR_HANDLING_FAIL", обработок, очисток, возвращено)
конец

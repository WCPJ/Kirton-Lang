попробовать {
    импорт "invalid" из "bytecode_modules"
} перехватить ошибка {
    если ошибка.код == "runtime" и ошибка.сообщение == "Ожидалось 'конец' для функции перед концом файла" {
        печатать("MODULE_PARSE_ERROR_OK")
    } иначе {
        печатать("MODULE_PARSE_ERROR_MISMATCH")
    }
} всегда {
    печатать("MODULE_FINALLY")
}

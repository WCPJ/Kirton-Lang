функция сделать(n) {
  попробовать {
    вернуть [n, "Киртон", n + 9223372036854775807]
  } всегда {
    пусть i = 0
    пока i < 4 {
      пусть мусор = ["очистка", i, 9223372036854775808]
      i = i + 1
    }
  }
}
пусть n = 0
пусть сумма = 0
пока n < 1200 {
  пусть a = сделать(n)
  сумма = сумма + a[0]
  n = n + 1
}
печатать(сумма)

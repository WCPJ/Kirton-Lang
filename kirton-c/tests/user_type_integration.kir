импорт "user_type_module" как типы из "tests"

пусть данные = типы.создать()
пусть счётчик = типы.создать_счётчик()
пусть enum_значение = типы.состояние()
пусть первая = счётчик()
пусть вторая = счётчик()

попробовать
    типы.испортить(данные)
перехватить ошибка
    если ошибка.код != "runtime" или ошибка.стек[0]["функция"] != "испортить" то
        печатать("USER_TYPE_INTEGRATION_FAIL_ERROR")
    конец
конец

данные.значение = данные.значение + 2
если данные.значение == 12 и первая.значение == 32 и
   вторая.значение == 32 и типы.активно_ли(enum_значение) == истина то
    печатать("USER_TYPE_INTEGRATION_OK")
иначе
    печатать("USER_TYPE_INTEGRATION_FAIL")
конец

пусть число = 10

функция локальное()
    пусть число = 20
    пусть повтор = 1
    пусть повтор = 2
    вернуть число * 100 + повтор
конец

функция изменить_внешнее()
    число = 30
    вернуть число
конец

если локальное() != 2002 то
    печатать("SCOPE_BINDINGS_FAIL_LOCAL")
конец
если число != 10 то
    печатать("SCOPE_BINDINGS_FAIL_SHADOW")
конец
если изменить_внешнее() != 30 или число != 30 то
    печатать("SCOPE_BINDINGS_FAIL_ASSIGN")
конец
печатать("SCOPE_BINDINGS_OK")

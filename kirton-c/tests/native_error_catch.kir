пусть перехвачено = 0
пусть очищено = 0

функция вызвать_ошибку_json()
    json_написать(нан())
конец

попробовать
    вызвать_ошибку_json()
    печатать("NATIVE_ERROR_FAIL_AFTER")
перехватить ошибка
    если ошибка.код == "runtime" и ошибка.сообщение != "" и
       ошибка.файл == "<json>" и ошибка.строка == 1 и ошибка.столбец == 1 и
       ошибка.стек[0]["функция"] == "вызвать_ошибку_json" то
        перехвачено = перехвачено + 1
    конец
всегда
    очищено = очищено + 1
конец

если перехвачено == 1 и очищено == 1 то
    печатать("NATIVE_ERROR_CATCH_OK")
иначе
    печатать("NATIVE_ERROR_CATCH_FAIL")
конец

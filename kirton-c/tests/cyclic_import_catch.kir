фс_записать_текст("cycle_a.кир", "импорт \"cycle_b\" из \".\"")
фс_записать_текст("cycle_b.кир", "импорт \"cycle_a\" из \".\"")
пусть перехвачено = 0
попробовать
    импорт "cycle_a" из "."
перехватить ошибка
    перехвачено = 1
всегда
    удалить_файл("cycle_a.кир")
    удалить_файл("cycle_b.кир")
конец
если перехвачено == 1 то
    печатать("CYCLE_IMPORT_CAUGHT_OK")
иначе
    печатать("CYCLE_IMPORT_CAUGHT_FAIL")
конец

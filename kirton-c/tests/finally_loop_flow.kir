пусть очисток = 0
пусть итераций = 0

функция прервать_с_очисткой()
    пока истина
        попробовать
            прервать
        всегда
            очисток = очисток + 1
        конец
    конец
конец

прервать_с_очисткой()
пока итераций < 3
    итераций = итераций + 1
    попробовать
        продолжить
    всегда
        очисток = очисток + 1
    конец
конец

если очисток == 4 и итераций == 3 то
    печатать("FINALLY_LOOP_FLOW_OK")
иначе
    печатать("FINALLY_LOOP_FLOW_FAIL", очисток, итераций)
конец

set(dir "${WORK_DIR}/module_cache_growth")
file(MAKE_DIRECTORY "${dir}")
set(imports "")
foreach(i RANGE 0 19)
  file(WRITE "${dir}/dep${i}.kir" "// empty module\n")
  string(APPEND imports "импорт \"dep${i}\" из \"${dir}\"\n")
endforeach()
file(WRITE "${dir}/outer.kir" "${imports}функция ответ() вернуть 42 конец\n")
file(WRITE "${dir}/main.kir" "импорт \"outer\" как тест из \"${dir}\"\nпечатать(тест.ответ())\n")
execute_process(COMMAND "${KIRTON_EXE}" "${dir}/main.kir"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
if(NOT result EQUAL 0 OR NOT output MATCHES "42")
  message(FATAL_ERROR "Вложенные импорты: код=${result}, вывод=${output}, ошибка=${error}")
endif()

функция вычислить_и_отбросить(x) {
    пусть временная = x * x
}

пусть живое = 115792089237316195423570985008687907853269984665640564039457584007913129639936
пусть счётчик = 9223372036854774807
пока счётчик < 9223372036854775808 {
    вычислить_и_отбросить(живое + счётчик)
    счётчик = счётчик + 1
}
печатать(счётчик)
печатать(живое)

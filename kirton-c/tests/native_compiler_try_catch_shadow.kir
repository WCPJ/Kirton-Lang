пусть ошибка = "outer"
функция test() {
  пусть ошибка = "fn outer"
  попробовать {
    пусть а = [1]
    печатать(а[9])
  } перехватить ошибка {
    печатать(ошибка.код)
  } всегда {
    печатать(ошибка)
  }
  печатать(ошибка)
}
test()
попробовать {
  пусть x = [2]
  печатать(x[19])
} перехватить ошибка {
  печатать(ошибка.код)
} всегда {
  печатать(ошибка)
}
печатать(ошибка)

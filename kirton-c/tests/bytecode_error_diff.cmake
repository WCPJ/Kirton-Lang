execute_process(COMMAND "${KIRTON}" -e main "${SOURCE}" RESULT_VARIABLE ast_rc OUTPUT_VARIABLE ast_out ERROR_VARIABLE ast_err)
execute_process(COMMAND "${KIRTON}" --bytecode -e main "${SOURCE}" RESULT_VARIABLE bc_rc OUTPUT_VARIABLE bc_out ERROR_VARIABLE bc_err)
if(ast_rc EQUAL 0 OR bc_rc EQUAL 0)
  message(FATAL_ERROR "Expected both modes to fail (AST=${ast_rc}, bytecode=${bc_rc})")
endif()
if(NOT ast_out STREQUAL bc_out)
  message(FATAL_ERROR "Output before the division error differs (AST=[${ast_out}], bytecode=[${bc_out}])")
endif()
if(NOT ast_err MATCHES "ноль" OR NOT bc_err MATCHES "ноль")
  message(FATAL_ERROR "Expected both modes to report division by zero (AST=${ast_err}, bytecode=${bc_err})")
endif()

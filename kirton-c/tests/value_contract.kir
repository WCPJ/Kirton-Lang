пусть большое = 9007199254740993
пусть список = [пусто, истина, большое, 1.25, "Киртон", [2], {"ключ": 3}]
пусть словарь = {"целое": большое, "число": 1.25, "вложенное": [пусто, ложь]}

пусть типы_верны =
    тип(пусто) == "пусто" и
    тип(истина) == "булево" и
    тип(большое) == "целое" и
    тип(1.25) == "число" и
    тип("Киртон") == "строка" и
    тип([]) == "список" и
    тип({}) == "словарь" и
    тип(список) == "список" и
    тип(словарь) == "словарь"

пусть точность_верна =
    большое != 9007199254740992 и
    большое + 7 == 9007199254741000 и
    1.25 * 4.0 == 5.0

пусть коллекции_верны =
    список == [пусто, истина, 9007199254740993, 1.25, "Киртон", [2], {"ключ": 3}] и
    словарь == {"вложенное": [пусто, ложь], "число": 1.25, "целое": 9007199254740993}

если типы_верны и точность_верна и коллекции_верны то
    печатать("VALUE_CONTRACT_OK")
иначе
    печатать("VALUE_CONTRACT_FAIL")
конец

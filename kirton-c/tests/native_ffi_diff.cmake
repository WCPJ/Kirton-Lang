# AST/Bytecode/Native differential including opt-in FFI and resource/record handles.
if(NOT DEFINED KIRTON OR NOT DEFINED SOURCE OR NOT DEFINED TEST_NAME)
  message(FATAL_ERROR "KIRTON SOURCE TEST_NAME required")
endif()
if(CMAKE_HOST_WIN32)
  set(suffix ".exe")
else()
  set(suffix "")
endif()
set(ffi_options)
if(USE_FFI)
  list(APPEND ffi_options --allow-ffi)
endif()
set(native_exe "${CMAKE_CURRENT_BINARY_DIR}/kirton_native_ffi_${TEST_NAME}${suffix}")
set(native_source "${SOURCE}")
if(DEFINED NATIVE_PLUGIN AND NOT "${NATIVE_PLUGIN}" STREQUAL "")
  if(NOT EXISTS "${NATIVE_PLUGIN}")
    message(FATAL_ERROR "Missing Clang-sanitized native FFI plugin: ${NATIVE_PLUGIN}")
  endif()
  file(READ "${SOURCE}" source_content)
  string(FIND "${source_content}" "${HOST_PLUGIN}" plugin_position)
  if(plugin_position EQUAL -1 OR "${HOST_PLUGIN}" STREQUAL "")
    message(FATAL_ERROR "Cannot replace original plugin path in ${SOURCE}")
  endif()
  string(REPLACE "${HOST_PLUGIN}" "${NATIVE_PLUGIN}" source_content "${source_content}")
  set(native_source "${CMAKE_CURRENT_BINARY_DIR}/kirton_native_ffi_${TEST_NAME}_sanitized.kir")
  file(WRITE "${native_source}" "${source_content}")
endif()
set(ast_stdout "")
set(ast_result "")
foreach(mode ast bytecode native)
  if(mode STREQUAL "native")
    execute_process(COMMAND "${KIRTON}" --native ${ffi_options} "${native_source}" -o "${native_exe}"
      RESULT_VARIABLE compiled OUTPUT_VARIABLE compile_stdout ERROR_VARIABLE compile_stderr
      ENCODING UTF-8 TIMEOUT 45)
    if(NOT "${compiled}" STREQUAL "0")
      message(FATAL_ERROR "native compile failed rc=${compiled}: ${compile_stderr}")
    endif()
    execute_process(COMMAND "${native_exe}"
      RESULT_VARIABLE rc OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr
      ENCODING UTF-8 TIMEOUT 35)
  elseif(mode STREQUAL "bytecode")
    execute_process(COMMAND "${KIRTON}" --bytecode ${ffi_options} "${SOURCE}"
      RESULT_VARIABLE rc OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr
      ENCODING UTF-8 TIMEOUT 35)
  else()
    execute_process(COMMAND "${KIRTON}" ${ffi_options} "${SOURCE}"
      RESULT_VARIABLE rc OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr
      ENCODING UTF-8 TIMEOUT 35)
  endif()
  string(REPLACE "\r\n" "\n" stdout "${stdout}")
  string(STRIP "${stdout}" stdout)
  if(mode STREQUAL "ast")
    set(ast_stdout "${stdout}")
    set(ast_result "${rc}")
  elseif(NOT "${rc}" STREQUAL "${ast_result}" OR NOT "${stdout}" STREQUAL "${ast_stdout}")
    message(FATAL_ERROR "${mode} mismatch: AST rc=${ast_result} stdout=[${ast_stdout}]; actual rc=${rc} stdout=[${stdout}]; stderr=[${stderr}]")
  endif()
  if(DEFINED EXPECT AND NOT "${stdout}" STREQUAL "${EXPECT}")
    message(FATAL_ERROR "${mode} output expected=[${EXPECT}] actual=[${stdout}]")
  endif()
  if(DEFINED EXIT_CODE AND NOT "${rc}" STREQUAL "${EXIT_CODE}")
    message(FATAL_ERROR "${mode} exit expected=${EXIT_CODE} actual=${rc}")
  endif()
endforeach()
file(REMOVE "${native_exe}" "${native_exe}.kirton-native.ll")

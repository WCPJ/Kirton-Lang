функция main()
    пусть id = звук_загрузить("../data/test.wav")
    если id > 0 и звук_освободить(id) == истина то
        печатать("SOUND_LOAD_FREE_OK")
    иначе
        печатать("SOUND_LOAD_FREE_FAIL")
    конец

    если звук_загрузить(42) == 0 и звук_играть(-1) == ложь и звук_освободить(-1) == ложь и звук_играть(-2147483648) == ложь и звук_играть_цикл(-2147483648) == ложь и звук_освободить(-2147483648) == ложь то
        печатать("SOUND_INVALID_OK")
    иначе
        печатать("SOUND_INVALID_FAIL")
    конец
конец

пусть температура = 21
если температура > 20 {
    печатать("тепло")
} иначе {
    печатать("прохладно")
}

функция факториал(n) {
    если n <= 1 {
        вернуть 1
    }
    вернуть n * факториал(n - 1)
}

пусть данные = {"имя": "Аня", "номер": факториал(5)}
если данные["номер"] == 120 и данные["имя"] == "Аня" {
    печатать("HANDBOOK_EXAMPLES_OK")
}

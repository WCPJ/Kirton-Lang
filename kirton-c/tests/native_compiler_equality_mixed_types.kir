пусть вызовы = 0
функция получить_число() {
    вызовы = вызовы + 1
    вернуть 42
}
функция получить_строку() {
    вызовы = вызовы + 1
    вернуть "42"
}
печатать(получить_число() == получить_строку())
печатать(вызовы)
печатать(получить_число() != получить_строку())
печатать(вызовы)
печатать(0 == ложь)
печатать(истина != "истина")
печатать("42" != 42)
печатать(2.0 == истина)

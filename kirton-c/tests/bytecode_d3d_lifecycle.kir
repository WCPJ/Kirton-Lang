импорт d3d11

функция main()
    если d3d11.create_window(320, 240, "Kirton D3D lifecycle test") == ложь то
        печатать("D3D_WINDOW_UNAVAILABLE")
    иначе
        пусть очищено = d3d11.clear(0.1, 0.2, 0.3, 1.0)
        пусть показано = d3d11.present(ложь)
        пусть размер = d3d11.window_size()
        пусть закрыто = d3d11.destroy()
        если очищено и показано и список_длина(размер) == 2 и закрыто то
            печатать("D3D_LIFECYCLE_OK")
        иначе
            печатать("D3D_LIFECYCLE_FAIL")
        конец
    конец
конец

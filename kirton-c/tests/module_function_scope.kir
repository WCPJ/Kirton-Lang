функция значение()
    вернуть 100
конец
импорт "module_scope_a" как первый из "tests"
импорт "module_scope_b" как второй из "tests"
если первый.вычислить() == 11 и второй.вычислить() == 22 и значение() == 100 и первый.счет(3) == 3 и второй.счет(3) == 30 то
    печатать("MODULE_FUNCTION_SCOPE_OK")
иначе
    печатать("MODULE_FUNCTION_SCOPE_FAIL", первый.вычислить(), второй.вычислить(), значение())

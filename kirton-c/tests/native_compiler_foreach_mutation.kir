пусть значения = [1, 2]
пусть текст = ""
для каждого элемент в значения {
    если элемент == 1 {
        список_добавить(значения, 3)
        продолжить
    }
    текст = текст + "x"
}
печатать(список_длина(значения), текст)
пусть а = список_пустой()
пусть n = 0
пока n < 250 {
    список_добавить(а, n)
    n = n + 1
}
пусть s = 0
для каждого э в а {
    s = s + э
}
печатать(s, список_длина(а))

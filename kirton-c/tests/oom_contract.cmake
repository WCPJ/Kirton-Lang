foreach(mode gc_mark bigint vm_start ast_runtime)
  set(oom_command "${OOM_CONTRACT_EXE}" "${mode}")
  if(DEFINED ENV{KIRTON_OOM_DISABLE_LSAN})
    set(oom_command "${CMAKE_COMMAND}" -E env "ASAN_OPTIONS=detect_leaks=0" ${oom_command})
  endif()
  execute_process(COMMAND ${oom_command}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error_output TIMEOUT 5)
  if(error_output MATCHES "AddressSanitizer|LeakSanitizer|UndefinedBehaviorSanitizer|runtime error:")
    message(FATAL_ERROR "${mode} emitted sanitizer diagnostics: ${error_output}")
  endif()
  if(result EQUAL 0 OR NOT error_output MATCHES "OOM")
    message(FATAL_ERROR "${mode} did not follow the documented fail-fast contract: result=${result}; stdout=[${output}]; stderr=[${error_output}]")
  endif()
endforeach()

foreach(mode lexer arena ffi_create vm_init bytecode_ffi_init)
  execute_process(COMMAND "${OOM_CONTRACT_EXE}" "${mode}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error_output TIMEOUT 5)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${mode} fallible OOM path failed: result=${result}; stdout=[${output}]; stderr=[${error_output}]")
  endif()
endforeach()

set(ast_fail_fast_count 0)
set(ast_recovered_count 0)
set(ast_success_count 0)
foreach(fail_after RANGE 0 160)
  set(oom_command "${OOM_CONTRACT_EXE}" ast_root_sweep "${fail_after}")
  if(DEFINED ENV{KIRTON_OOM_DISABLE_LSAN})
    set(oom_command "${CMAKE_COMMAND}" -E env "ASAN_OPTIONS=detect_leaks=0" ${oom_command})
  endif()
  execute_process(COMMAND ${oom_command}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error_output TIMEOUT 5)
  if(error_output MATCHES "AddressSanitizer|LeakSanitizer|UndefinedBehaviorSanitizer|runtime error:")
    message(FATAL_ERROR "AST/root OOM sweep ${fail_after} emitted sanitizer diagnostics: ${error_output}")
  endif()
  if(result EQUAL 0 AND output MATCHES "AST_OOM_NOT_HIT")
    math(EXPR ast_success_count "${ast_success_count}+1")
  elseif(result EQUAL 0 AND output MATCHES "AST_OOM_RECOVERED")
    math(EXPR ast_recovered_count "${ast_recovered_count}+1")
  elseif(error_output MATCHES "OOM")
    math(EXPR ast_fail_fast_count "${ast_fail_fast_count}+1")
  else()
    message(FATAL_ERROR "AST/root OOM sweep ${fail_after} failed outside the fail-fast contract: result=${result}; stdout=[${output}]; stderr=[${error_output}]")
  endif()
endforeach()
if(ast_fail_fast_count EQUAL 0 OR ast_success_count EQUAL 0)
  message(FATAL_ERROR "AST/root OOM sweep lacked fail-fast/success cases: fail-fast=${ast_fail_fast_count}; recovered=${ast_recovered_count}; success=${ast_success_count}")
endif()

set(fail_fast_count 0)
set(recovered_count 0)
set(success_count 0)
foreach(fail_after RANGE 0 512)
  set(oom_command "${OOM_CONTRACT_EXE}" bytecode_sweep "${fail_after}" "${BYTECODE_SOURCE}")
  if(DEFINED ENV{KIRTON_OOM_DISABLE_LSAN})
    set(oom_command "${CMAKE_COMMAND}" -E env "ASAN_OPTIONS=detect_leaks=0" ${oom_command})
  endif()
  execute_process(COMMAND ${oom_command}
    WORKING_DIRECTORY "${WORKING_DIRECTORY}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error_output TIMEOUT 5)
  if(error_output MATCHES "AddressSanitizer|LeakSanitizer|UndefinedBehaviorSanitizer|runtime error:")
    message(FATAL_ERROR "Bytecode OOM sweep ${fail_after} emitted sanitizer diagnostics: ${error_output}")
  endif()
  if(result EQUAL 0)
    if(output MATCHES "BYTECODE_OOM_RECOVERED")
      math(EXPR recovered_count "${recovered_count}+1")
    elseif(output MATCHES "BYTECODE_OOM_NOT_HIT")
      math(EXPR success_count "${success_count}+1")
    else()
      message(FATAL_ERROR "Bytecode OOM sweep ${fail_after} returned no result marker: ${output}${error_output}")
    endif()
  elseif(error_output MATCHES "OOM")
    math(EXPR fail_fast_count "${fail_fast_count}+1")
  else()
    message(FATAL_ERROR "Bytecode OOM sweep ${fail_after} failed outside the documented contract: result=${result}; stdout=[${output}]; stderr=[${error_output}]")
  endif()
endforeach()
if(fail_fast_count EQUAL 0 OR success_count EQUAL 0)
  message(FATAL_ERROR "Bytecode OOM sweep lacked fail-fast/success cases: fail-fast=${fail_fast_count}; recovered=${recovered_count}; success=${success_count}")
endif()
message(STATUS "AST/root allocation sweep: fail-fast=${ast_fail_fast_count}; recovered-and-reused=${ast_recovered_count}; injection-not-reached=${ast_success_count}")
message(STATUS "Bytecode allocation sweep: fail-fast=${fail_fast_count}; recovered-and-reused=${recovered_count}; injection-not-reached=${success_count}")

импорт внешний
функция проверить_внешний(путь)
    пусть загружено = внешний.загрузить(путь)
    если загружено != истина то
        вернуть -1
    конец
    пусть точное = внешний.вызвать("арифметика", "сложить", 9007199254740993, 7)
    если точное != 9007199254741000 то
        вернуть -2
    конец
    пусть дробное = внешний.вызвать("арифметика", "умножить", 1.5, 4.0)
    если дробное != 6 то
        вернуть -3
    конец
    пусть логическое = внешний.вызвать("арифметика", "инвертировать", ложь)
    если логическое != истина то
        вернуть -4
    конец
    вернуть точное
конец

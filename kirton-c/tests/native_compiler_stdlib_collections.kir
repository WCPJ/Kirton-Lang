пусть числа = [1, 2, 3]
пусть копия = список_копия(числа)
печатать(список_установить(копия, 1, 99), копия, числа)
печатать(список_индекс(копия, 99))
печатать(подсписок([0, 1, 2, 3, 4], 1, 3))
печатать(список_соединить([1, 2], [3, 4]))
печатать(список_очистить(копия), копия)
пусть записи = {"а": 1, "б": 2}
пусть новый = словарь_копия(записи)
печатать(словарь_ключи(новый), словарь_значения(новый))
печатать(словарь_пары(новый))
печатать(словарь_очистить(новый), записи)

функция первый(пакет) {
    для каждого предмет в пакет {
        если предмет == "цель" { вернуть предмет }
    }
    вернуть пусто
}
пусть счет = 0
пусть результат = ""
для каждого x в [[1, 2], [3], [], [4, 5]] {
    для каждого y в x {
        если y == 2 { продолжить }
        если y == 5 { прервать }
        счет = счет + y
    }
}
для каждого ch в "Я🧭ё" {
    результат = результат + ch
}
печатать(счет, результат, первый(["не", "цель", "после"]), первый([]))
пусть неитерируемый = 99
для каждого x в неитерируемый {
    счет = 1000
}
печатать(счет)

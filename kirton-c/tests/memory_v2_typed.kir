импорт память

пусть область = память.создать(256)
пусть a = память.массив(область, "целое32", 6)
пусть b = память.массив(область, "число64", 3)
пусть c = память.массив(область, "целое64", 2)
пусть bytes = память.массив(область, "байт", 4)
пусть ok = тип(a) == "типизированный_массив"
ok = ok и память.длина_массива(a) == 6
ok = ok и память.тип_массива(a) == "целое32" и память.тип_массива(b) == "число64"
ok = ok и a[0] == 0 и память.взять(a, 5) == 0
a[0] = -2147483648
a[5] = 2147483647
b[0] = 1.25
b[2] = -2.5
c[0] = 9007199254740993
bytes[1] = 255
ok = ok и a[0] == -2147483648 и a[5] == 2147483647
пусть сумма = 0
для каждого элемент в a
    сумма = сумма + элемент
конец
ok = ok и сумма == -1
ok = ok и b[0] == 1.25 и b[2] == -2.5
ok = ok и c[0] == 9007199254740993 и bytes[1] == 255
пусть alias = a
ok = ok и alias[5] == 2147483647
память.сбросить(область)
ok = ok и не память.действителен_массив(a)
пусть after = память.массив(область, "целое32", 2)
ok = ok и after[0] == 0
память.закрыть(область)
ok = ok и не память.действителен_массив(after)
если ok то
    печатать("MEMORY_V2_TYPED_OK")
иначе
    печатать("MEMORY_V2_TYPED_FAIL")
конец

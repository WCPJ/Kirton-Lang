функция вычислить(число)
    вернуть число + 123
конец

пусть большое = вычислить(100000000000000000000000000000000)
пусть сохранено = [большое, {"число": большое}]
пусть шаг = 0
пока шаг < 5000
    большое = большое + 1
    шаг = шаг + 1
конец

если сохранено[0] == 100000000000000000000000000000123 и сохранено[1].число == 100000000000000000000000000000123 и большое == 100000000000000000000000000005123 то
    печатать("BIGINT_RETENTION_OK")
иначе
    печатать("BIGINT_RETENTION_FAIL")
конец

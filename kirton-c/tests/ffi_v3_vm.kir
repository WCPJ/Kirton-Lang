импорт память
импорт внешний

функция подготовить_запись()
    пусть схема = память.структура("здоровье", "целое32", "идентификатор", "целое64", "скорость", "число64")
    пусть область = память.создать(4096)
    пусть игрок = память.запись(область, схема)
    игрок.здоровье = 42
    игрок.идентификатор = 9007199254740993
    игрок.скорость = 2.5
    вернуть игрок
конец

функция проверить_копирование(путь)
    внешний.загрузить(путь)
    пусть игрок = подготовить_запись()
    пусть точное = внешний.вызвать("структуры", "проверить", игрок)
    пусть новый = внешний.вызвать("структуры", "копировать", игрок)
    если игрок.здоровье != 42 то
        вернуть -1
    конец
    если точное != 9007199254740993 то
        вернуть -2
    конец
    если новый.здоровье != 42 то
        вернуть -3
    конец
    если новый.идентификатор != точное то
        вернуть -4
    конец
    вернуть точное
конец

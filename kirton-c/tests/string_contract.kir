пусть короткая_замена = строка_заменить("aaaa", "aa", "b")
пусть длинная_замена = строка_заменить("aba", "a", "long")
пусть без_совпадений = строка_заменить("Киртон", "нет", "есть")
пусть склеенная = строка_склеить(["Киртон", "1.0", "язык"], " / ")

если короткая_замена == "bb" и длинная_замена == "longblong" и
   без_совпадений == "Киртон" и склеенная == "Киртон / 1.0 / язык" то
    печатать("STRING_CONTRACT_OK")
иначе
    печатать("STRING_CONTRACT_FAIL", короткая_замена, длинная_замена, склеенная)
конец

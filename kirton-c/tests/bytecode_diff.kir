пусть start = 2
функция вычислить(x) {
  пусть i = 0
  пусть sum = 0
  пока i < x {
    если i < 3 {
      sum = sum + i * 2
    } иначе {
      sum = sum + i
    }
    i = i + 1
  }
  вернуть sum + start
}
пусть order = 0
функция main() {
  печатать(вычислить(6))
  печатать("ok" + "!", 1 + 2 * 3)
  печатать(9223372036854775808 + 1, -7 % 3, 7 / 2)
  печатать(mark(1) + mark(2), order)
  если 4 >= 4 {
    печатать("compare-ok")
  }
}
функция mark(x) {
  order = order * 10 + x
  вернуть x
}

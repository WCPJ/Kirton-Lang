импорт "native_compiler_module_user_type_outer" как снаружи
импорт "native_compiler_module_user_type_inner" как внутри
пусть обёртка = снаружи.собрать(9223372036854775808)
печатать(обёртка.имя)
печатать(обёртка.вложенный[0].имя)
печатать(обёртка.вложенный[0].значение)
печатать(снаружи.сравнить_из_глубины())
печатать(внутри.сравнить_цвет(внутри.взять_цвет()))
